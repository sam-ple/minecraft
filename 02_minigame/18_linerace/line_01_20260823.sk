# ============================================================
# LINERACE TEST
# Version : v0.1.00
#
# 機能
#   /line start
#       現在位置をスタート地点として記録
#
#   /line stop
#       ゲーム停止
#
#   /line status
#       現在の状態を表示
#
#   ・スタート地点から横にズレたら死亡
#   ・前後方向の移動は自由
#   ・まずは横ズレ判定のみ
#
# ============================================================


# ============================================================
# START
# ============================================================

command /line <text>:
    trigger:

        # ====================================================
        # START
        # ====================================================

        if arg-1 is "start":

            # -----------------------------------------------
            # 現在位置を取得
            # -----------------------------------------------

            set {line.active} to true

            set {line.world} to world of player

            set {line.start.x} to x-coordinate of player
            set {line.start.y} to y-coordinate of player
            set {line.start.z} to z-coordinate of player


            # -----------------------------------------------
            # 進行方向
            #
            # 今回はテストとして Z+ を前方向とする
            #
            # Z方向に進む
            # X方向にズレたら死亡
            # -----------------------------------------------

            set {line.start.x.int} to floor(x-coordinate of player)


            # -----------------------------------------------
            # スタート地点表示
            # -----------------------------------------------

            send "&a================================"
            send "&aLINE RACE START"
            send "&a================================"

            send "&eStart X : &f%{line.start.x}%"
            send "&eStart Y : &f%{line.start.y}%"
            send "&eStart Z : &f%{line.start.z}%"

            send "&7前方向 : Z+"
            send "&c横方向 : X"
            send "&c横にズレると死亡"

            send "&a================================"


            # -----------------------------------------------
            # 判定ループ
            # -----------------------------------------------

            while {line.active} is true:

                # プレイヤーが別ワールドへ行った場合
                if world of player is not {line.world}:

                    kill player

                    send "&cLINE RACE : WORLD ERROR"

                    set {line.active} to false

                    stop


                # -------------------------------------------
                # 現在のX座標
                # -------------------------------------------

                set {_current.x} to x-coordinate of player


                # -------------------------------------------
                # 横ズレ量
                #
                # スタートXとの差
                # -------------------------------------------

                set {_offset} to {_current.x} - {line.start.x}


                # -------------------------------------------
                # 絶対値
                # -------------------------------------------

                if {_offset} < 0:

                    set {_offset} to {_offset} * -1


                # -------------------------------------------
                # 横ズレ判定
                #
                # 1ブロック以上ズレたら死亡
                #
                # 例
                # start X = 100.5
                #
                # X = 100.9
                # → OK
                #
                # X = 101.5
                # → OUT
                # -------------------------------------------

                if {_offset} >= 1:

                    send "&c================================"
                    send "&cLINE RACE FAILED"
                    send "&c横にズレました"
                    send "&cOffset : %{_offset}%"
                    send "&c================================"

                    kill player

                    set {line.active} to false

                    stop


                # -------------------------------------------
                # 少し待つ
                # -------------------------------------------

                wait 1 tick


        # ====================================================
        # STOP
        # ====================================================

        else if arg-1 is "stop":

            set {line.active} to false

            send "&eLINE RACE STOPPED"


        # ====================================================
        # STATUS
        # ====================================================

        else if arg-1 is "status":

            if {line.active} is true:

                send "&aLINE RACE : ACTIVE"

                send "&7Start X : %{line.start.x}%"
                send "&7Start Y : %{line.start.y}%"
                send "&7Start Z : %{line.start.z}%"

            else:

                send "&cLINE RACE : INACTIVE"


        # ====================================================
        # UNKNOWN
        # ====================================================

        else:

            send "&e================================"
            send "&eLINE RACE COMMAND"
            send "&e================================"
            send "&f/line start &7- スタート"
            send "&f/line stop &7- 停止"
            send "&f/line status &7- 状態確認"
            send "&e================================"
