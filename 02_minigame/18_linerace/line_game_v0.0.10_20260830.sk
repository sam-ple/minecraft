# ============================================================
# LINERACE GAME SYSTEM
# Version : v0.2.10
#
# Minecraft Java Edition
# Paper + Skript 2.16.1
#
# ============================================================
#
# COMMAND
#
#   /line
#       Open LineRace GUI
#
# ============================================================
#
# FEATURES
#
# ・5 lanes
# ・SET registers a player's lane
# ・Any number of registered players can start
# ・Maximum players = number of lanes
# ・START can be pressed even while SET mode is active
# ・START automatically finishes SET mode
# ・Game time selectable: 5 / 10 / 15 minutes
# ・STOP ends the current game
# ・STOP keeps lane registration data
# ・START can be used again after STOP
# ・RESET completely deletes registration data
# ・Countdown: 3 → 2 → 1 → GO!
# ・Game starts in daytime
# ・Night starts at half of the game time
# ・BossBar timer
# ・Blue / solid BossBar
# ・Distance shown on scoreboard
# ・Distance shown in TAB
# ・Lane check
# ・Player is killed when leaving lane
# ・After death, player returns to start
# ・Respawn / teleport protection
# ・Wool can be broken
# ・Wool does not drop
# ・Other blocks behave normally
# ・Final position is calculated at game end
# ・Final result is shown to all players
# ・End countdown:
#     0:00 → 5 → 4 → 3 → 2 → 1 → GAME SET
#
# ============================================================
# SAFETY / STABILITY
#
# ・Registration data survives /reload
# ・START validates registered player data
# ・RESPAWN handlers are merged
# ・RESET removes registered player heads
# ・STOP / GAME SET clean protection data
# ・Game ID prevents old delayed processes from interfering
# ・BossBar is restored when a player rejoins
#
# ============================================================


# ============================================================
# LOAD
# ============================================================

on load:

    # --------------------------------------------------------
    # Runtime state
    #
    # IMPORTANT:
    # Registration data is NOT deleted on reload.
    # --------------------------------------------------------

    set {linerace.running} to false
    set {linerace.setup} to false
    set {linerace.countdown} to false
    set {linerace.finish} to false

    set {linerace.time} to 0
    set {linerace.duration} to 900
    set {linerace.night} to false

    # --------------------------------------------------------
    # Game ID
    #
    # Used to prevent old delayed processes
    # from interfering with a new game.
    # --------------------------------------------------------

    if {linerace.game.id} is not set:
        set {linerace.game.id} to 0


    # --------------------------------------------------------
    # Runtime protection
    # --------------------------------------------------------

    delete {linerace.protection::*}


    # --------------------------------------------------------
    # Current distance
    # --------------------------------------------------------

    delete {linerace.distance::*}


    # --------------------------------------------------------
    # Final distance
    # --------------------------------------------------------

    delete {linerace.final.distance::*}


    # --------------------------------------------------------
    # Scoreboard objective
    #
    # If it already exists, Minecraft simply reports
    # that it already exists. The objective itself is kept.
    # --------------------------------------------------------

    execute console command "scoreboard objectives add linerace.distance dummy Distance"


    # --------------------------------------------------------
    # Remove old BossBar
    # --------------------------------------------------------

    set {_bar} to boss bar with key "linerace:timer"

    if {_bar} is set:

        remove all players from {_bar}

        delete {_bar}


    # --------------------------------------------------------
    # Clear sidebar
    # --------------------------------------------------------

    execute console command "scoreboard objectives setdisplay sidebar"


    # --------------------------------------------------------
    # Reset TAB for online players
    # --------------------------------------------------------

    loop all players:

        set tab list name of loop-player to "%loop-player%"


    send "&aLineRace System v0.2.10 loaded." to console


# ============================================================
# MAIN COMMAND
#
# /line
# ============================================================

command /line:

    permission: op

    trigger:

        # ----------------------------------------------------
        # Count registered ONLINE players
        # ----------------------------------------------------

        set {_count} to 0

        loop all players:

            if {linerace.player::%loop-player%} is set:

                add 1 to {_count}


        # ----------------------------------------------------
        # Status
        # ----------------------------------------------------

        if {linerace.running} is true:

            if {linerace.countdown} is true:

                set {_status} to "&6COUNTDOWN"

            else:

                set {_status} to "&aRUNNING"

        else if {linerace.finish} is true:

            set {_status} to "&cFINISHING"

        else if {linerace.setup} is true:

            set {_status} to "&eSET MODE"

        else:

            set {_status} to "&7READY"


        # ----------------------------------------------------
        # Time
        # ----------------------------------------------------

        set {_minutes} to floor({linerace.duration} / 60)

        set {_timeText} to "%{_minutes}% MIN"


        # ----------------------------------------------------
        # GUI
        # ----------------------------------------------------

        set {_gui} to chest inventory with 3 rows named "&6&lLINERACE"


        # ----------------------------------------------------
        # SET
        # ----------------------------------------------------

        set slot 1 of {_gui} to emerald named "&a&lSET"

        set lore of slot 1 of {_gui} to "&7Register your lane." and "&7Click to enter SET mode."


        # ----------------------------------------------------
        # START
        # ----------------------------------------------------

        set slot 3 of {_gui} to diamond named "&e&lSTART"

        set lore of slot 3 of {_gui} to "&7Start LineRace." and "&7Registered players: %{_count}%"


        # ----------------------------------------------------
        # TIME
        # ----------------------------------------------------

        set slot 5 of {_gui} to clock named "&b&lTIME"

        set lore of slot 5 of {_gui} to "&7Current: &f%{_timeText}%" and "&7Click to change."


        # ----------------------------------------------------
        # STOP
        # ----------------------------------------------------

        set slot 7 of {_gui} to redstone torch named "&c&lSTOP"

        set lore of slot 7 of {_gui} to "&7Stop the current game." and "&7Registration data will remain."


        # ----------------------------------------------------
        # RESET
        # ----------------------------------------------------

        set slot 19 of {_gui} to barrier named "&4&lRESET"

        set lore of slot 19 of {_gui} to "&7Delete all LineRace data." and "&cThis cannot be undone."


        # ----------------------------------------------------
        # STATUS
        # ----------------------------------------------------

        set slot 21 of {_gui} to paper named "&f&lSTATUS"

        set lore of slot 21 of {_gui} to "&7Players: &f%{_count}%" and "&7Status: %{_status}%"


        # ----------------------------------------------------
        # Open GUI
        # ----------------------------------------------------

        open {_gui} to player


# ============================================================
# MAIN GUI CLICK
# ============================================================

on inventory click:

    if name of event-inventory is not "&6&lLINERACE":

        stop


    cancel event


    # ========================================================
    # SET
    # ========================================================

    if clicked slot is 1:

        close player's inventory


        if {linerace.running} is true:

            send "&cSET cannot be used during a game." to player

            stop


        if {linerace.finish} is true:

            send "&cLineRace is finishing. Please wait for GAME SET." to player

            stop


        set {linerace.setup} to true


        send "" to all players
        send "&a&l==============================" to all players
        send "&a&l          LINERACE SET" to all players
        send "&fPlease click a lane button." to all players
        send "&a&l==============================" to all players
        send "" to all players

        stop


    # ========================================================
    # START
    # ========================================================

    if clicked slot is 3:

        close player's inventory


        # ----------------------------------------------------
        # Already running
        # ----------------------------------------------------

        if {linerace.running} is true:

            send "&cLineRace is already running." to player

            stop


        # ----------------------------------------------------
        # Finish countdown
        # ----------------------------------------------------

        if {linerace.finish} is true:

            send "&cLineRace is finishing. Please wait for GAME SET." to player

            stop


        # ----------------------------------------------------
        # Count registered players
        # ----------------------------------------------------

        set {_count} to 0

        loop all players:

            if {linerace.player::%loop-player%} is set:

                add 1 to {_count}


        if {_count} is 0:

            send "&cNo registered players." to player

            stop


        # ----------------------------------------------------
        # Maximum 5 lanes
        # ----------------------------------------------------

        if {_count} > 5:

            send "&cToo many registered players." to player
            send "&7Maximum players: 5" to player

            stop


        # ----------------------------------------------------
        # START preflight validation
        #
        # Every online registered player must have:
        # ・lane
        # ・start X
        # ・start Y
        # ・start Z
        # ・world
        # ----------------------------------------------------

        set {_valid} to true

        loop all players:

            if {linerace.player::%loop-player%} is set:

                set {_p} to loop-player

                if {linerace.player::%{_p}%} is not set:

                    set {_valid} to false

                if {linerace.start.x::%{_p}%} is not set:

                    set {_valid} to false

                if {linerace.start.y::%{_p}%} is not set:

                    set {_valid} to false

                if {linerace.start.z::%{_p}%} is not set:

                    set {_valid} to false

                if {linerace.start.world::%{_p}%} is not set:

                    set {_valid} to false


        if {_valid} is not true:

            send "&cSTART failed." to player
            send "&7One or more registered players have invalid start data." to player

            stop


        # ----------------------------------------------------
        # START automatically finishes SET mode
        # ----------------------------------------------------

        set {linerace.setup} to false


        # ----------------------------------------------------
        # New game ID
        #
        # This invalidates all delayed processing from
        # previous games.
        # ----------------------------------------------------

        add 1 to {linerace.game.id}

        set {_gameID} to {linerace.game.id}


        # ----------------------------------------------------
        # Start state
        # ----------------------------------------------------

        set {linerace.running} to true
        set {linerace.countdown} to true
        set {linerace.finish} to false

        set {linerace.time} to 0
        set {linerace.night} to false


        # ----------------------------------------------------
        # Daytime
        # ----------------------------------------------------

        execute console command "time set day"


        # ----------------------------------------------------
        # Scoreboard
        # ----------------------------------------------------

        execute console command "scoreboard objectives setdisplay sidebar linerace.distance"


        # ----------------------------------------------------
        # BossBar
        #
        # Initial display uses selected game duration.
        # ----------------------------------------------------

        set {_minutes} to floor({linerace.duration} / 60)

        set {_bar} to a new keyed blue bossbar with key "linerace:timer" with title "LINERACE %{_minutes}%:00"

        set progress of {_bar} to 100%

        set style of {_bar} to solid


        # ----------------------------------------------------
        # Add registered players to BossBar
        # ----------------------------------------------------

        loop all players:

            if {linerace.player::%loop-player%} is set:

                add loop-player to viewers of {_bar}


        # ----------------------------------------------------
        # Move registered players to start
        # ----------------------------------------------------

        loop all players:

            if {linerace.player::%loop-player%} is not set:

                continue


            set {_p} to loop-player


            # ------------------------------------------------
            # Start position
            # ------------------------------------------------

            set {_x} to {linerace.start.x::%{_p}%}
            set {_y} to {linerace.start.y::%{_p}%}
            set {_z} to {linerace.start.z::%{_p}%}
            set {_world} to {linerace.start.world::%{_p}%}


            # ------------------------------------------------
            # Vanilla spawnpoint
            # ------------------------------------------------

            set {_spawnX} to floor({_x})
            set {_spawnY} to floor({_y})
            set {_spawnZ} to floor({_z})

            execute console command "spawnpoint %{_p}% %{_spawnX}% %{_spawnY}% %{_spawnZ}%"


            # ------------------------------------------------
            # Score reset
            # ------------------------------------------------

            execute console command "scoreboard players set %{_p}% linerace.distance 0"


            # ------------------------------------------------
            # Distance reset
            # ------------------------------------------------

            set {linerace.distance::%{_p}%} to 0

            set {linerace.final.distance::%{_p}%} to 0


            # ------------------------------------------------
            # Protection
            # ------------------------------------------------

            set {linerace.protection::%{_p}%} to true


            # ------------------------------------------------
            # TAB
            # ------------------------------------------------

            set {_lane} to {linerace.player::%{_p}%}

            set tab list name of {_p} to "&7[%{_lane}%] &f%{_p}% &8- &e0m"


            # ------------------------------------------------
            # Teleport
            # ------------------------------------------------

            teleport {_p} to location({_x}, {_y}, {_z}, {_world})


        # ====================================================
        # COUNTDOWN
        # ====================================================

        send title "&6&l3" with subtitle "&fGET READY" to all players

        wait 1 second

        # ----------------------------------------------------
        # Check that this is still the same game
        # ----------------------------------------------------

        if {linerace.game.id} is not {_gameID}:

            stop

        if {linerace.running} is not true:

            stop


        send title "&e&l2" with subtitle "&fGET READY" to all players

        wait 1 second

        if {linerace.game.id} is not {_gameID}:

            stop

        if {linerace.running} is not true:

            stop


        send title "&a&l1" with subtitle "&fGET READY" to all players

        wait 1 second

        if {linerace.game.id} is not {_gameID}:

            stop

        if {linerace.running} is not true:

            stop


        # ----------------------------------------------------
        # Game timer starts here.
        #
        # The 3-second countdown is NOT included.
        # ----------------------------------------------------

        set {linerace.time} to 0


        # ----------------------------------------------------
        # Remove protection
        # ----------------------------------------------------

        loop all players:

            if {linerace.player::%loop-player%} is set:

                delete {linerace.protection::%loop-player%}


        # ----------------------------------------------------
        # GO
        # ----------------------------------------------------

        send title "&b&lGO!" with subtitle "&fLINERACE START!" to all players


        send "" to all players
        send "&6&l==============================" to all players
        send "&e&l        LINERACE START!" to all players
        send "&6&l==============================" to all players
        send "" to all players


        set {linerace.countdown} to false

        stop


    # ========================================================
    # TIME
    # ========================================================

    if clicked slot is 5:

        close player's inventory


        if {linerace.running} is true:

            send "&cTime cannot be changed during a game." to player

            stop


        if {linerace.finish} is true:

            send "&cTime cannot be changed while finishing." to player

            stop


        # ----------------------------------------------------
        # Cycle:
        #
        # 5 → 10 → 15 → 5
        # ----------------------------------------------------

        if {linerace.duration} is 300:

            set {linerace.duration} to 600

        else if {linerace.duration} is 600:

            set {linerace.duration} to 900

        else:

            set {linerace.duration} to 300


        set {_minutes} to floor({linerace.duration} / 60)

        send "&bGame time set to %{_minutes}% minutes." to player

        stop


    # ========================================================
    # STOP
    # ========================================================

    if clicked slot is 7:

        close player's inventory


        if {linerace.running} is not true:

            send "&cLineRace is not running." to player

            stop


        # ----------------------------------------------------
        # Invalidate delayed processing
        # ----------------------------------------------------

        add 1 to {linerace.game.id}


        # ----------------------------------------------------
        # Stop game
        # ----------------------------------------------------

        set {linerace.running} to false
        set {linerace.countdown} to false
        set {linerace.setup} to false
        set {linerace.finish} to false

        set {linerace.time} to 0
        set {linerace.night} to false


        # ----------------------------------------------------
        # Remove BossBar
        # ----------------------------------------------------

        set {_bar} to boss bar with key "linerace:timer"

        if {_bar} is set:

            remove all players from {_bar}

            delete {_bar}


        # ----------------------------------------------------
        # Remove scoreboard
        # ----------------------------------------------------

        execute console command "scoreboard objectives setdisplay sidebar"


        # ----------------------------------------------------
        # Reset scores
        # ----------------------------------------------------

        loop all players:

            execute console command "scoreboard players reset %loop-player% linerace.distance"


        # ----------------------------------------------------
        # Return registered players to start
        # ----------------------------------------------------

        loop all players:

            if {linerace.player::%loop-player%} is not set:

                continue


            set {_p} to loop-player


            if {linerace.start.x::%{_p}%} is not set:

                continue


            set {_x} to {linerace.start.x::%{_p}%}
            set {_y} to {linerace.start.y::%{_p}%}
            set {_z} to {linerace.start.z::%{_p}%}
            set {_world} to {linerace.start.world::%{_p}%}


            # ------------------------------------------------
            # Protection
            # ------------------------------------------------

            set {linerace.protection::%{_p}%} to true


            # ------------------------------------------------
            # Distance reset
            # ------------------------------------------------

            set {linerace.distance::%{_p}%} to 0


            # ------------------------------------------------
            # TAB reset
            # ------------------------------------------------

            set {_lane} to {linerace.player::%{_p}%}

            set tab list name of {_p} to "&7[%{_lane}%] &f%{_p}% &8- &e0m"


            # ------------------------------------------------
            # Teleport
            # ------------------------------------------------

            teleport {_p} to location({_x}, {_y}, {_z}, {_world})


            # Game is already stopped, so protection is
            # no longer needed.
            delete {linerace.protection::%{_p}%}


        # ----------------------------------------------------
        # STOP message
        # ----------------------------------------------------

        send "" to all players
        send "&c&l==============================" to all players
        send "&c&l        LINERACE STOPPED" to all players
        send "&fThe game has been stopped." to all players
        send "&7Registration data has been kept." to all players
        send "&c&l==============================" to all players
        send "" to all players

        stop


    # ========================================================
    # RESET
    # ========================================================

    if clicked slot is 19:

        close player's inventory


        # ----------------------------------------------------
        # Invalidate all delayed processing
        # ----------------------------------------------------

        add 1 to {linerace.game.id}


        # ----------------------------------------------------
        # Stop everything
        # ----------------------------------------------------

        set {linerace.running} to false
        set {linerace.setup} to false
        set {linerace.countdown} to false
        set {linerace.finish} to false

        set {linerace.time} to 0
        set {linerace.duration} to 900
        set {linerace.night} to false


        # ----------------------------------------------------
        # Remove BossBar
        # ----------------------------------------------------

        set {_bar} to boss bar with key "linerace:timer"

        if {_bar} is set:

            remove all players from {_bar}

            delete {_bar}


        # ----------------------------------------------------
        # Remove scoreboard
        # ----------------------------------------------------

        execute console command "scoreboard objectives setdisplay sidebar"


        # ----------------------------------------------------
        # Reset scores
        # ----------------------------------------------------

        loop all players:

            execute console command "scoreboard players reset %loop-player% linerace.distance"


        # ----------------------------------------------------
        # Delete player heads
        # ----------------------------------------------------

        loop all players:

            if {linerace.head.x::%loop-player%} is not set:

                continue


            set {_hx} to {linerace.head.x::%loop-player%}
            set {_hy} to {linerace.head.y::%loop-player%}
            set {_hz} to {linerace.head.z::%loop-player%}
            set {_hw} to {linerace.head.world::%loop-player%}


            set {_headBlock} to block at location({_hx}, {_hy}, {_hz}, {_hw})


            if {_headBlock} is player head:

                set block at location({_hx}, {_hy}, {_hz}, {_hw}) to air


        # ----------------------------------------------------
        # Reset TAB
        # ----------------------------------------------------

        loop all players:

            set tab list name of loop-player to "%loop-player%"


        # ----------------------------------------------------
        # Delete registration data
        # ----------------------------------------------------

        delete {linerace.player::*}
        delete {linerace.lane.player::*}


        # ----------------------------------------------------
        # Delete start data
        # ----------------------------------------------------

        delete {linerace.start.x::*}
        delete {linerace.start.y::*}
        delete {linerace.start.z::*}
        delete {linerace.start.world::*}


        # ----------------------------------------------------
        # Delete head data
        # ----------------------------------------------------

        delete {linerace.head.x::*}
        delete {linerace.head.y::*}
        delete {linerace.head.z::*}
        delete {linerace.head.world::*}


        # ----------------------------------------------------
        # Delete protection
        # ----------------------------------------------------

        delete {linerace.protection::*}


        # ----------------------------------------------------
        # Delete distance
        # ----------------------------------------------------

        delete {linerace.distance::*}


        # ----------------------------------------------------
        # Delete final distance
        # ----------------------------------------------------

        delete {linerace.final.distance::*}


        # ----------------------------------------------------
        # RESET message
        # ----------------------------------------------------

        send "" to all players
        send "&c&l==============================" to all players
        send "&c&l          LINERACE RESET" to all players
        send "&fAll registration data has been deleted." to all players
        send "&fGame time has been reset to 15 minutes." to all players
        send "&c&l==============================" to all players
        send "" to all players

        stop


# ============================================================
# LANE SELECT
#
# Right-click a stone button during SET mode.
# ============================================================

on right click on stone button:

    cancel event


    # --------------------------------------------------------
    # SET mode check
    # --------------------------------------------------------

    if {linerace.setup} is not true:

        stop


    # --------------------------------------------------------
    # Running check
    # --------------------------------------------------------

    if {linerace.running} is true:

        stop


    # --------------------------------------------------------
    # Finish check
    # --------------------------------------------------------

    if {linerace.finish} is true:

        stop


    # --------------------------------------------------------
    # Player already has a lane
    # --------------------------------------------------------

    if {linerace.player::%player%} is set:

        send "&cYou have already selected a lane." to player

        stop


    # ========================================================
    # BUTTON POSITION
    # ========================================================

    set {_buttonX} to floor(x-coordinate of event-block)
    set {_buttonY} to floor(y-coordinate of event-block)
    set {_buttonZ} to floor(z-coordinate of event-block)


    # ========================================================
    # CONCRETE
    #
    # Button
    #   ↓
    # Concrete
    #   ↓
    # Wool
    # ========================================================

    set {_concreteX} to {_buttonX}
    set {_concreteY} to {_buttonY}
    set {_concreteZ} to {_buttonZ} + 1


    set {_concrete} to block at location({_concreteX}, {_concreteY}, {_concreteZ}, world of event-block)


    # ========================================================
    # COLOR
    # ========================================================

    if {_concrete} is white concrete:

        set {_color} to "white"

    else if {_concrete} is orange concrete:

        set {_color} to "orange"

    else if {_concrete} is light blue concrete:

        set {_color} to "light_blue"

    else if {_concrete} is lime concrete:

        set {_color} to "lime"

    else if {_concrete} is yellow concrete:

        set {_color} to "yellow"

    else:

        send "&cThis is not a LineRace start button." to player

        stop


    # ========================================================
    # CHECK LANE
    # ========================================================

    if {linerace.lane.player::%{_color}%} is set:

        send "&cThis lane is already occupied." to player

        stop


    # ========================================================
    # CHECK MAX PLAYERS
    # ========================================================

    set {_count} to 0

    loop all players:

        if {linerace.player::%loop-player%} is set:

            add 1 to {_count}


    if {_count} >= 5:

        send "&cMaximum 5 players can register." to player

        stop


    # ========================================================
    # FIND WOOL
    # ========================================================

    set {_woolX} to {_concreteX}
    set {_woolZ} to {_concreteZ} + 1

    set {_woolFound} to false


    loop 41 times:

        set {_offset} to loop-number - 21
        set {_checkY} to {_concreteY} + {_offset}


        set {_checkBlock} to block at location({_woolX}, {_checkY}, {_woolZ}, world of event-block)


        if {_color} is "white":

            if {_checkBlock} is white wool:

                set {_woolY} to {_checkY}
                set {_woolFound} to true

                stop loop


        else if {_color} is "orange":

            if {_checkBlock} is orange wool:

                set {_woolY} to {_checkY}
                set {_woolFound} to true

                stop loop


        else if {_color} is "light_blue":

            if {_checkBlock} is light blue wool:

                set {_woolY} to {_checkY}
                set {_woolFound} to true

                stop loop


        else if {_color} is "lime":

            if {_checkBlock} is lime wool:

                set {_woolY} to {_checkY}
                set {_woolFound} to true

                stop loop


        else if {_color} is "yellow":

            if {_checkBlock} is yellow wool:

                set {_woolY} to {_checkY}
                set {_woolFound} to true

                stop loop


    # ========================================================
    # NOT FOUND
    # ========================================================

    if {_woolFound} is not true:

        send "&cStart wool was not found." to player

        send "&7Search X=%{_woolX}% Z=%{_woolZ}%" to player

        send "&7Concrete Y=%{_concreteY}%" to player

        stop


    # ========================================================
    # START POSITION
    # ========================================================

    set {_startX} to {_woolX} + 0.5
    set {_startY} to {_woolY} + 1
    set {_startZ} to {_woolZ} + 0.5


    # ========================================================
    # SAVE PLAYER
    # ========================================================

    set {linerace.player::%player%} to {_color}

    set {linerace.lane.player::%{_color}%} to player


    # ========================================================
    # SAVE START
    # ========================================================

    set {linerace.start.x::%player%} to {_startX}
    set {linerace.start.y::%player%} to {_startY}
    set {linerace.start.z::%player%} to {_startZ}
    set {linerace.start.world::%player%} to world of event-block


    # ========================================================
    # HEAD POSITION
    # ========================================================

    set {_headX} to {_concreteX}
    set {_headY} to {_concreteY} + 1
    set {_headZ} to {_concreteZ}


    set {linerace.head.x::%player%} to {_headX}
    set {linerace.head.y::%player%} to {_headY}
    set {linerace.head.z::%player%} to {_headZ}
    set {linerace.head.world::%player%} to world of event-block


    # ========================================================
    # PLAYER HEAD
    # ========================================================

    set block at location({_headX}, {_headY}, {_headZ}, world of event-block) to player's skull


    # ========================================================
    # SPAWNPOINT
    # ========================================================

    set {_spawnX} to {_woolX}
    set {_spawnY} to {_woolY} + 1
    set {_spawnZ} to {_woolZ}


    execute console command "spawnpoint %player% %{_spawnX}% %{_spawnY}% %{_spawnZ}%"


    # ========================================================
    # SCORE
    # ========================================================

    execute console command "scoreboard players set %player% linerace.distance 0"


    # ========================================================
    # DISTANCE
    # ========================================================

    set {linerace.distance::%player%} to 0


    # ========================================================
    # PROTECTION
    # ========================================================

    set {linerace.protection::%player%} to true


    # ========================================================
    # TAB
    # ========================================================

    set tab list name of player to "&7[%{_color}%] &f%player% &8- &e0m"


    # ========================================================
    # TELEPORT
    # ========================================================

    teleport player to location({_startX}, {_startY}, {_startZ}, world of event-block)


    wait 1 second


    # --------------------------------------------------------
    # Make sure player is still registered and no game started
    # --------------------------------------------------------

    if {linerace.player::%player%} is set:

        if {linerace.running} is not true:

            delete {linerace.protection::%player%}


    # ========================================================
    # MESSAGE
    # ========================================================

    send "&a&lLane registered!" to player

    send "&7Lane: &f%{_color}%" to player

    send "&7Wool: &f%{_woolX}%, %{_woolY}%, %{_woolZ}%" to player

    send "&7Start: &f%{_startX}%, %{_startY}%, %{_startZ}%" to player

    send "&e%player% &7→ &f%{_color}% &7lane" to all players


# ============================================================
# BLOCK BREAK
#
# Wool does not drop.
# Other blocks behave normally.
# ============================================================

on break:

    if event-block is white wool:

        clear drops

    else if event-block is orange wool:

        clear drops

    else if event-block is light blue wool:

        clear drops

    else if event-block is lime wool:

        clear drops

    else if event-block is yellow wool:

        clear drops


# ============================================================
# GAME LOOP
#
# 2 ticks = 0.1 second
#
# ・Lane check
# ・Distance
# ・TAB display
# ・Action Bar
# ============================================================

every 2 ticks:

    if {linerace.running} is not true:

        stop


    if {linerace.countdown} is true:

        stop


    loop all players:

        if {linerace.player::%loop-player%} is not set:

            continue


        set {_p} to loop-player


        # ====================================================
        # POSITION
        # ====================================================

        set {_px} to x-coordinate of {_p}
        set {_py} to y-coordinate of {_p}
        set {_pz} to z-coordinate of {_p}


        # ====================================================
        # LANE
        # ====================================================

        set {_lane} to {linerace.player::%{_p}%}


        # ====================================================
        # START
        # ====================================================

        set {_sx} to {linerace.start.x::%{_p}%}
        set {_sy} to {linerace.start.y::%{_p}%}
        set {_sz} to {linerace.start.z::%{_p}%}


        # ====================================================
        # X DIFFERENCE
        # ====================================================

        set {_xdiff} to {_px} - {_sx}

        set {_absdiff} to abs({_xdiff})


        # ====================================================
        # DISTANCE
        #
        # Only Z direction is counted.
        # ====================================================

        set {_distanceRaw} to {_pz} - {_sz}

        set {_distance} to floor({_distanceRaw})


        if {_distance} < 0:

            set {_distance} to 0


        # ====================================================
        # SAVE DISTANCE
        # ====================================================

        set {linerace.distance::%{_p}%} to {_distance}


        # ====================================================
        # SCOREBOARD
        # ====================================================

        execute console command "scoreboard players set %{_p}% linerace.distance %{_distance}%"


        # ====================================================
        # TAB
        #
        # [LANE] PLAYER - DISTANCEm
        # ====================================================

        set tab list name of {_p} to "&7[%{_lane}%] &f%{_p}% &8- &e%{_distance}%m"


        # ====================================================
        # ACTION BAR
        # ====================================================

        send action bar "&eLane: &f%{_lane}% &8| &eDistance: &f%{_distance}%m &8| &eXDiff: &f%{_xdiff}% &8| &eLimit: &f±1.0" to {_p}


        # ====================================================
        # PROTECTION
        # ====================================================

        if {linerace.protection::%{_p}%} is set:

            continue


        # ====================================================
        # LANE CHECK
        #
        # Player dies if X deviation is greater than 1 block.
        # ====================================================

        if {_absdiff} > 1:

            set {linerace.protection::%{_p}%} to true

            kill {_p}

            continue


# ============================================================
# GAME TIMER
#
# Duration:
#   300 = 5 minutes
#   600 = 10 minutes
#   900 = 15 minutes
#
# Night:
#   Halfway point
#
# End:
#
#   0:00
#      ↓
#   5
#      ↓
#   4
#      ↓
#   3
#      ↓
#   2
#      ↓
#   1
#      ↓
#   GAME SET
#
# GAME SET is exactly 5 seconds after 0:00.
# ============================================================

every 1 second:

    if {linerace.running} is not true:

        stop


    if {linerace.countdown} is true:

        stop


    add 1 to {linerace.time}


    # ========================================================
    # NIGHT
    # ========================================================

    set {_halfTime} to {linerace.duration} / 2


    if {linerace.time} >= {_halfTime}:

        if {linerace.night} is not true:

            set {linerace.night} to true

            execute console command "time set night"


    # ========================================================
    # REMAINING
    # ========================================================

    set {_remaining} to {linerace.duration} - {linerace.time}


    if {_remaining} < 0:

        set {_remaining} to 0


    # ========================================================
    # TIME TEXT
    # ========================================================

    set {_minutes} to floor({_remaining} / 60)

    set {_seconds} to {_remaining} - ({_minutes} * 60)


    if {_seconds} < 10:

        set {_secondText} to "0%{_seconds}%"

    else:

        set {_secondText} to "%{_seconds}%"


    set {_timeText} to "%{_minutes}%:%{_secondText}%"


    # ========================================================
    # BOSSBAR
    # ========================================================

    set {_bar} to boss bar with key "linerace:timer"


    if {_bar} is set:

        set title of {_bar} to "LINERACE %{_timeText}%"

        set progress of {_bar} to ({_remaining} / {linerace.duration}) * 100%


    # ========================================================
    # GAME END
    # ========================================================

    if {linerace.time} >= {linerace.duration}:

        if {linerace.finish} is true:

            stop


        # ----------------------------------------------------
        # FINISH state
        #
        # running becomes false.
        # finish remains true until GAME SET.
        # ----------------------------------------------------

        set {linerace.finish} to true
        set {linerace.running} to false
        set {linerace.countdown} to false


        # ----------------------------------------------------
        # Save current game ID.
        #
        # If RESET / START changes the ID during the
        # countdown, this process terminates.
        # ----------------------------------------------------

        set {_finishGameID} to {linerace.game.id}


        # ====================================================
        # BossBar 0:00
        # ====================================================

        set {_bar} to boss bar with key "linerace:timer"


        if {_bar} is set:

            set title of {_bar} to "LINERACE 0:00"

            set progress of {_bar} to 0%


        # ====================================================
        # FINAL DISTANCE
        # ====================================================

        loop all players:

            if {linerace.player::%loop-player%} is not set:

                continue


            set {_p} to loop-player


            set {_pz} to z-coordinate of {_p}

            set {_sz} to {linerace.start.z::%{_p}%}


            set {_finalRaw} to {_pz} - {_sz}

            set {_finalDistance} to floor({_finalRaw})


            if {_finalDistance} < 0:

                set {_finalDistance} to 0


            set {linerace.final.distance::%{_p}%} to {_finalDistance}


        # ====================================================
        # FINISH MESSAGE
        # ====================================================

        send "" to all players
        send "&6&l==============================" to all players
        send "&e&l        LINERACE FINISH!" to all players
        send "&6&l==============================" to all players
        send "" to all players


        # ====================================================
        # RESULT
        # ====================================================

        loop all players:

            if {linerace.player::%loop-player%} is not set:

                continue


            set {_p} to loop-player

            set {_distance} to {linerace.final.distance::%{_p}%}

            set {_lane} to {linerace.player::%{_p}%}


            send "&e%{_p}% &7→ &f%{_lane}% &7: &6%{_distance}%m" to all players


        # ====================================================
        # TELEPORT TO START
        #
        # This happens before the finish countdown.
        # ====================================================

        loop all players:

            if {linerace.player::%loop-player%} is not set:

                continue


            set {_p} to loop-player


            set {_x} to {linerace.start.x::%{_p}%}
            set {_y} to {linerace.start.y::%{_p}%}
            set {_z} to {linerace.start.z::%{_p}%}
            set {_world} to {linerace.start.world::%{_p}%}


            set {linerace.protection::%{_p}%} to true


            teleport {_p} to location({_x}, {_y}, {_z}, {_world})


        # ====================================================
        # FINISH COUNTDOWN
        #
        # 0:00 → 5 → 4 → 3 → 2 → 1 → GAME SET
        # ====================================================

        send title "&c&l5" with subtitle "&f" to all players

        wait 1 second


        # ----------------------------------------------------
        # Abort if another process changed the game ID.
        # ----------------------------------------------------

        if {linerace.game.id} is not {_finishGameID}:

            stop


        if {linerace.finish} is not true:

            stop


        send title "&c&l4" with subtitle "&f" to all players

        wait 1 second


        if {linerace.game.id} is not {_finishGameID}:

            stop


        if {linerace.finish} is not true:

            stop


        send title "&6&l3" with subtitle "&f" to all players

        wait 1 second


        if {linerace.game.id} is not {_finishGameID}:

            stop


        if {linerace.finish} is not true:

            stop


        send title "&e&l2" with subtitle "&f" to all players

        wait 1 second


        if {linerace.game.id} is not {_finishGameID}:

            stop


        if {linerace.finish} is not true:

            stop


        send title "&a&l1" with subtitle "&f" to all players

        wait 1 second


        if {linerace.game.id} is not {_finishGameID}:

            stop


        if {linerace.finish} is not true:

            stop


        # ====================================================
        # GAME SET
        # ====================================================

        send title "&b&lGAME SET!" with subtitle "&fLINERACE FINISHED" to all players


        send "" to all players
        send "&6&l==============================" to all players
        send "&b&l          GAME SET!" to all players
        send "&fThe LineRace game has ended." to all players
        send "&6&l==============================" to all players
        send "" to all players


        # ====================================================
        # Remove BossBar
        # ====================================================

        set {_bar} to boss bar with key "linerace:timer"


        if {_bar} is set:

            remove all players from {_bar}

            delete {_bar}


        # ====================================================
        # Remove scoreboard
        # ====================================================

        execute console command "scoreboard objectives setdisplay sidebar"


        # ====================================================
        # Reset scores
        # ====================================================

        loop all players:

            execute console command "scoreboard players reset %loop-player% linerace.distance"


        # ====================================================
        # Delete protection
        # ====================================================

        delete {linerace.protection::*}


        # ====================================================
        # TAB
        #
        # Keep final distance visible after GAME SET.
        # ====================================================

        loop all players:

            if {linerace.player::%loop-player%} is not set:

                continue


            set {_p} to loop-player

            set {_lane} to {linerace.player::%{_p}%}

            set {_distance} to {linerace.final.distance::%{_p}%}


            set tab list name of {_p} to "&7[%{_lane}%] &f%{_p}% &8- &6%{_distance}%m"


        # ====================================================
        # Reset runtime finish state
        #
        # Registration remains.
        #
        # GAME SET → START
        # is possible immediately.
        # ====================================================

        set {linerace.finish} to false
        set {linerace.time} to 0
        set {linerace.night} to false

        stop


# ============================================================
# RESPAWN
#
# During game:
#
# ・Return to start
# ・Reset distance
# ・Reset scoreboard
# ・Reset TAB
# ・Enable temporary protection
#
# One handler only.
# ============================================================

on respawn:

    if {linerace.running} is not true:

        stop


    if {linerace.player::%player%} is not set:

        stop


    if {linerace.start.x::%player%} is not set:

        stop


    # ========================================================
    # Start position
    # ========================================================

    set {_x} to {linerace.start.x::%player%}
    set {_y} to {linerace.start.y::%player%}
    set {_z} to {linerace.start.z::%player%}
    set {_world} to {linerace.start.world::%player%}


    set respawn location to location({_x}, {_y}, {_z}, {_world})


    # ========================================================
    # Score reset
    # ========================================================

    execute console command "scoreboard players set %player% linerace.distance 0"


    set {linerace.distance::%player%} to 0


    # ========================================================
    # TAB reset
    # ========================================================

    set {_lane} to {linerace.player::%player%}

    set tab list name of player to "&7[%{_lane}%] &f%player% &8- &e0m"


    # ========================================================
    # Protection
    # ========================================================

    set {linerace.protection::%player%} to true


    # ========================================================
    # Protection release
    #
    # Wait until the player has actually respawned.
    # ========================================================

    wait 1 second


    if {linerace.running} is true:

        if {linerace.player::%player%} is set:

            delete {linerace.protection::%player%}


# ============================================================
# QUIT
# ============================================================

on quit:

    if {linerace.player::%player%} is not set:

        stop


    if {linerace.running} is true:

        execute console command "scoreboard players reset %player% linerace.distance"

        set {linerace.distance::%player%} to 0


# ============================================================
# JOIN
#
# If a registered player rejoins during a game:
#
# ・Teleport to start
# ・Reset distance
# ・Restore TAB
# ・Restore BossBar
# ・Temporary protection
# ============================================================

on join:

    if {linerace.running} is not true:

        stop


    if {linerace.player::%player%} is not set:

        stop


    if {linerace.start.x::%player%} is not set:

        stop


    wait 2 ticks


    # ========================================================
    # Start position
    # ========================================================

    set {_x} to {linerace.start.x::%player%}
    set {_y} to {linerace.start.y::%player%}
    set {_z} to {linerace.start.z::%player%}
    set {_world} to {linerace.start.world::%player%}


    # ========================================================
    # Protection
    # ========================================================

    set {linerace.protection::%player%} to true


    # ========================================================
    # Teleport
    # ========================================================

    teleport player to location({_x}, {_y}, {_z}, {_world})


    # ========================================================
    # Score
    # ========================================================

    execute console command "scoreboard players set %player% linerace.distance 0"


    set {linerace.distance::%player%} to 0


    # ========================================================
    # TAB
    # ========================================================

    set {_lane} to {linerace.player::%player%}

    set tab list name of player to "&7[%{_lane}%] &f%player% &8- &e0m"


    # ========================================================
    # BossBar
    # ========================================================

    set {_bar} to boss bar with key "linerace:timer"


    if {_bar} is set:

        add player to viewers of {_bar}


    # ========================================================
    # Protection release
    # ========================================================

    wait 1 second


    if {linerace.running} is true:

        if {linerace.player::%player%} is set:

            delete {linerace.protection::%player%}
