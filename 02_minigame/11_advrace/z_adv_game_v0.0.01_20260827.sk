# ============================================================
# ADVANCEMENT RACE
# Version : v0.1.00
#
# MINIMUM ADVANCEMENT TEST
#
# Purpose
#   ・進捗取得イベントの検知
#   ・プレイヤー取得
#   ・進捗取得
#   ・+1 POINT
#   ・DEBUG表示
#
# Commands
#   /advrace start
#   /advrace stop
#   /advrace reset
#   /advrace status
#   /advrace debug
#
# ============================================================

options:
    prefix: &8[&bAdvRace&8]&r


# ============================================================
# START
# ============================================================

command /advrace start:
    permission: op
    trigger:

        set {advrace.running} to true

        send "{@prefix} &aAdvancement Race START!" to all players

        if {advrace.debug} is true:
            send "{@prefix} &7[DEBUG] State: &aRUNNING" to player


# ============================================================
# STOP
# ============================================================

command /advrace stop:
    permission: op
    trigger:

        set {advrace.running} to false

        send "{@prefix} &cAdvancement Race STOPPED." to all players


# ============================================================
# RESET
# ============================================================

command /advrace reset:
    permission: op
    trigger:

        delete {advrace.points::*}

        set {advrace.running} to false

        execute console command "scoreboard objectives remove advPoints"

        send "{@prefix} &eReset complete." to player


# ============================================================
# STATUS
# ============================================================

command /advrace status:
    permission: op
    trigger:

        send "&8&m--------------------------------"
        send "&bADVANCEMENT RACE"
        send "&8&m--------------------------------"

        if {advrace.running} is true:
            send "&7State: &aRUNNING"
        else:
            send "&7State: &cSTOPPED"

        send ""

        loop all players:

            set {_uuid} to uuid of loop-player

            set {_points} to {advrace.points::%{_uuid}%}

            if {_points} is not set:
                set {_points} to 0

            send "&f%loop-player% &7: &e%{_points}% point(s)"

        send "&8&m--------------------------------"


# ============================================================
# DEBUG TOGGLE
# ============================================================

command /advrace debug:
    permission: op
    trigger:

        if {advrace.debug} is true:

            set {advrace.debug} to false

            send "{@prefix} &7DEBUG: &cOFF"

        else:

            set {advrace.debug} to true

            send "{@prefix} &7DEBUG: &aON"


# ============================================================
# SCOREBOARD INITIALIZATION
# ============================================================

on script load:

    execute console command "scoreboard objectives remove advPoints"
    execute console command "scoreboard objectives add advPoints dummy Points"


# ============================================================
# ADVANCEMENT EVENT
# ============================================================

on advancement:

    if {advrace.running} is not true:
        stop

    set {_player} to event-player
    set {_uuid} to uuid of {_player}

    # --------------------------------------------------------
    # Advancement information
    # --------------------------------------------------------

    set {_advancement} to event-advancement


    # --------------------------------------------------------
    # POINT
    # --------------------------------------------------------

    add 1 to {advrace.points::%{_uuid}%}

    set {_points} to {advrace.points::%{_uuid}%}


    # --------------------------------------------------------
    # SCOREBOARD
    # --------------------------------------------------------

    execute console command "scoreboard players set %{_player}% advPoints %{_points}%"


    # --------------------------------------------------------
    # DEBUG
    # --------------------------------------------------------

    if {advrace.debug} is true:

        send "{@prefix} &8&m--------------------------------" to {_player}
        send "{@prefix} &7[DEBUG] Advancement detected!" to {_player}
        send "{@prefix} &7Player: &f%{_player}%" to {_player}
        send "{@prefix} &7Advancement: &e%{_advancement}%" to {_player}
        send "{@prefix} &7Point: &a+1" to {_player}
        send "{@prefix} &7Total: &e%{_points}%"
        send "{@prefix} &8&m--------------------------------" to {_player}