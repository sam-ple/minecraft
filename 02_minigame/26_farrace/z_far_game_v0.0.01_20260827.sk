# ============================================================
# FARRACE DISTANCE TEST
# Version : v0.1.01
# Date    : 2026-08-27
#
# Minecraft Java Edition + Paper + Skript
#
# ============================================================
#
# Purpose
#
#   Start地点から各プレイヤーまでの
#   XZ平面上の距離を測定するミニテスト。
#
#   Y座標は距離計算に使用しない。
#
#
# Distance
#
#   sqrt((X - StartX)^2 + (Z - StartZ)^2)
#
#
# Features
#
#   ・全プレイヤー共通スタート地点
#   ・スタート地点保存
#   ・全プレイヤーをスタート地点へTP
#   ・全プレイヤーのリスポーン地点設定
#   ・現在位置取得
#   ・XZ距離計算
#   ・距離を整数化
#   ・Scoreboard表示
#   ・DEBUG MODE
#   ・DEBUG MODE時、5秒ごとにConsoleへログ
#
#
# Commands
#
#   /farrace set
#   /farrace start
#   /farrace stop
#   /farrace debug
#   /farrace reset
#   /farrace status
#
# ============================================================


options:
    prefix: &8[&bFarRace&8]&r


# ============================================================
# MAIN COMMAND
#
# /farrace <subcommand>
#
# すべてのサブコマンドを1つのcommand定義にまとめる。
#
# ============================================================

command /farrace [<text>]:
    permission: op
    trigger:


        # ====================================================
        # SET
        #
        # 現在地を全プレイヤー共通のスタート地点として保存
        # ====================================================

        if arg-1 is "set":

            # ------------------------------------------------
            # Start Position
            # ------------------------------------------------

            set {farrace.start.x} to x-coordinate of player
            set {farrace.start.y} to y-coordinate of player
            set {farrace.start.z} to z-coordinate of player

            set {farrace.start.world} to world of player


            # ------------------------------------------------
            # Message
            # ------------------------------------------------

            send "{@prefix} &aStart position set!" to player

            send "{@prefix} &7X: &f%{farrace.start.x}%" to player
            send "{@prefix} &7Y: &f%{farrace.start.y}%" to player
            send "{@prefix} &7Z: &f%{farrace.start.z}%" to player
            send "{@prefix} &7World: &f%{farrace.start.world}%" to player

            stop


        # ====================================================
        # START
        #
        # ・ゲーム開始
        # ・全プレイヤーをスタート地点へTP
        # ・リスポーン地点設定
        # ・Scoreboard初期化
        # ====================================================

        if arg-1 is "start":

            # ------------------------------------------------
            # Start地点チェック
            # ------------------------------------------------

            if {farrace.start.x} is not set:

                send "{@prefix} &cStart position is not set." to player
                send "{@prefix} &7Use &f/farrace set &7first." to player

                stop


            # ------------------------------------------------
            # Worldチェック
            # ------------------------------------------------

            if {farrace.start.world} is not set:

                send "{@prefix} &cStart world is not set." to player

                stop


            # ------------------------------------------------
            # Running
            # ------------------------------------------------

            set {farrace.running} to true


            # ------------------------------------------------
            # Scoreboard
            # ------------------------------------------------

            execute console command "scoreboard objectives remove farDistance"

            execute console command "scoreboard objectives add farDistance dummy Distance"

            execute console command "scoreboard objectives setdisplay sidebar farDistance"


            # ------------------------------------------------
            # World Spawn
            #
            # ミニテストでは開始地点をワールドスポーンにも設定。
            # ------------------------------------------------

            execute console command "execute in %{farrace.start.world}% run setworldspawn %{farrace.start.x}% %{farrace.start.y}% %{farrace.start.z}%"


            # ------------------------------------------------
            # Respawn Point
            #
            # 全プレイヤーのリスポーン地点を設定。
            # ------------------------------------------------

            execute console command "execute in %{farrace.start.world}% run spawnpoint @a %{farrace.start.x}% %{farrace.start.y}% %{farrace.start.z}%"


            # ------------------------------------------------
            # Teleport
            #
            # 全プレイヤーを開始地点へ移動。
            # ------------------------------------------------

            execute console command "execute in %{farrace.start.world}% run tp @a %{farrace.start.x}% %{farrace.start.y}% %{farrace.start.z}%"


            # ------------------------------------------------
            # Player Initialization
            # ------------------------------------------------

            loop all players:

                set {_uuid} to uuid of loop-player

                set {farrace.distance::%{_uuid}%} to 0

                execute console command "scoreboard players set %loop-player% farDistance 0"


            # ------------------------------------------------
            # Start Message
            # ------------------------------------------------

            send "{@prefix} &aFarRace START!" to all players

            send "{@prefix} &7Start: &f%{farrace.start.x}% &7/ &f%{farrace.start.y}% &7/ &f%{farrace.start.z}%" to all players


            # ------------------------------------------------
            # Debug
            # ------------------------------------------------

            if {farrace.debug} is true:

                log "[FarRace DEBUG] Game started."

                log "[FarRace DEBUG] Start X=%{farrace.start.x}% Y=%{farrace.start.y}% Z=%{farrace.start.z}% World=%{farrace.start.world}%"


            stop


        # ====================================================
        # STOP
        #
        # 距離計測を停止。
        #
        # Scoreboardは残す。
        # ====================================================

        if arg-1 is "stop":

            if {farrace.running} is not true:

                send "{@prefix} &eFarRace is not running." to player

                stop


            set {farrace.running} to false

            send "{@prefix} &cFarRace STOPPED." to all players

            stop


        # ====================================================
        # DEBUG
        #
        # ON / OFFを切り替える。
        #
        # DEBUG ON中は5秒ごとにConsoleへ
        # 各プレイヤーの情報を出力。
        # ====================================================

        if arg-1 is "debug":

            if {farrace.debug} is true:

                set {farrace.debug} to false

                send "{@prefix} &7DEBUG MODE: &cOFF" to player

                log "[FarRace DEBUG] DEBUG MODE OFF."

            else:

                set {farrace.debug} to true

                send "{@prefix} &7DEBUG MODE: &aON" to player

                log "[FarRace DEBUG] DEBUG MODE ON."


                # --------------------------------------------
                # Start Position
                # --------------------------------------------

                if {farrace.start.x} is set:

                    log "[FarRace DEBUG] Start X=%{farrace.start.x}% Y=%{farrace.start.y}% Z=%{farrace.start.z}% World=%{farrace.start.world}%"

                else:

                    log "[FarRace DEBUG] Start position is NOT SET."


            stop


        # ====================================================
        # RESET
        #
        # ゲーム状態、スタート地点、距離、Scoreboardをリセット。
        # ====================================================

        if arg-1 is "reset":

            set {farrace.running} to false

            set {farrace.debug} to false


            # ------------------------------------------------
            # Start Position
            # ------------------------------------------------

            delete {farrace.start.x}
            delete {farrace.start.y}
            delete {farrace.start.z}
            delete {farrace.start.world}


            # ------------------------------------------------
            # Player Distance
            # ------------------------------------------------

            delete {farrace.distance::*}


            # ------------------------------------------------
            # Scoreboard
            # ------------------------------------------------

            execute console command "scoreboard objectives remove farDistance"


            # ------------------------------------------------
            # Message
            # ------------------------------------------------

            send "{@prefix} &eFarRace reset complete." to player

            stop


        # ====================================================
        # STATUS
        # ====================================================

        if arg-1 is "status":

            send "&8&m--------------------------------" to player

            send "&bFarRace STATUS" to player

            send "&8&m--------------------------------" to player


            # ------------------------------------------------
            # Game State
            # ------------------------------------------------

            if {farrace.running} is true:

                send "&7State : &aRUNNING" to player

            else:

                send "&7State : &cSTOPPED" to player


            # ------------------------------------------------
            # Debug State
            # ------------------------------------------------

            if {farrace.debug} is true:

                send "&7Debug : &aON" to player

            else:

                send "&7Debug : &cOFF" to player


            # ------------------------------------------------
            # Start Position
            # ------------------------------------------------

            if {farrace.start.x} is set:

                send "" to player

                send "&7Start X : &f%{farrace.start.x}%" to player

                send "&7Start Y : &f%{farrace.start.y}%" to player

                send "&7Start Z : &f%{farrace.start.z}%" to player

                send "&7World   : &f%{farrace.start.world}%" to player


            # ------------------------------------------------
            # Player Distance
            # ------------------------------------------------

            send "" to player

            loop all players:

                set {_uuid} to uuid of loop-player

                set {_distance} to {farrace.distance::%{_uuid}%}


                if {_distance} is not set:

                    set {_distance} to 0


                send "&f%loop-player% &7: &e%{_distance}% blocks" to player


            send "&8&m--------------------------------" to player

            stop


        # ====================================================
        # HELP
        # ====================================================

        send "&8&m--------------------------------" to player

        send "&bFarRace Distance Test" to player

        send "" to player

        send "&f/farrace set &7- Set start position" to player

        send "&f/farrace start &7- Start distance measurement" to player

        send "&f/farrace stop &7- Stop distance measurement" to player

        send "&f/farrace debug &7- Toggle debug mode" to player

        send "&f/farrace reset &7- Reset all data" to player

        send "&f/farrace status &7- Show status" to player

        send "&8&m--------------------------------" to player


# ============================================================
# SCRIPT LOAD
#
# Skriptをリロードした際は計測状態を停止。
#
# ============================================================

on script load:

    set {farrace.running} to false

    set {farrace.debug} to false

    delete {farrace.distance::*}

    execute console command "scoreboard objectives remove farDistance"


# ============================================================
# DISTANCE CALCULATION
#
# 1秒ごとに全プレイヤーの距離を更新。
#
#
# Distance:
#
#   sqrt(
#       (CurrentX - StartX)^2
#       +
#       (CurrentZ - StartZ)^2
#   )
#
#
# Y座標は完全に無視する。
#
# Scoreboardは整数のみなので、
# floor()で小数点以下を切り捨てる。
#
# ============================================================

every 1 second:

    # --------------------------------------------------------
    # Running Check
    # --------------------------------------------------------

    if {farrace.running} is not true:

        stop


    # --------------------------------------------------------
    # Start Position Check
    # --------------------------------------------------------

    if {farrace.start.x} is not set:

        stop


    # --------------------------------------------------------
    # All Players
    # --------------------------------------------------------

    loop all players:

        set {_uuid} to uuid of loop-player


        # ----------------------------------------------------
        # Current Position
        # ----------------------------------------------------

        set {_currentX} to x-coordinate of loop-player

        set {_currentZ} to z-coordinate of loop-player


        # ----------------------------------------------------
        # Difference
        # ----------------------------------------------------

        set {_dx} to {_currentX} - {farrace.start.x}

        set {_dz} to {_currentZ} - {farrace.start.z}


        # ----------------------------------------------------
        # XZ Distance
        #
        # Yは使用しない。
        # ----------------------------------------------------

        set {_distance} to sqrt(({_dx} * {_dx}) + ({_dz} * {_dz}))


        # ----------------------------------------------------
        # Integer
        #
        # Scoreboardは整数のみ。
        # ----------------------------------------------------

        set {_distanceInt} to floor({_distance})


        # ----------------------------------------------------
        # Save
        # ----------------------------------------------------

        set {farrace.distance::%{_uuid}%} to {_distanceInt}


        # ----------------------------------------------------
        # Scoreboard
        # ----------------------------------------------------

        execute console command "scoreboard players set %loop-player% farDistance %{_distanceInt}%"


# ============================================================
# DEBUG LOG
#
# DEBUG MODE ONの場合のみ5秒ごとに実行。
#
# Server Consoleへ以下を出力。
#
#   Player
#   Start
#   Current
#   DX
#   DZ
#   Distance
#   Score
#
# ============================================================

every 5 seconds:

    # --------------------------------------------------------
    # Debug Check
    # --------------------------------------------------------

    if {farrace.debug} is not true:

        stop


    # --------------------------------------------------------
    # Start Position Check
    # --------------------------------------------------------

    if {farrace.start.x} is not set:

        log "[FarRace DEBUG] Start position is NOT SET."

        stop


    # --------------------------------------------------------
    # Header
    # --------------------------------------------------------

    log "[FarRace DEBUG] ===== Distance Check ====="


    # --------------------------------------------------------
    # Every Player
    # --------------------------------------------------------

    loop all players:

        set {_uuid} to uuid of loop-player


        # ----------------------------------------------------
        # Current Position
        # ----------------------------------------------------

        set {_x} to x-coordinate of loop-player

        set {_y} to y-coordinate of loop-player

        set {_z} to z-coordinate of loop-player


        # ----------------------------------------------------
        # Difference
        # ----------------------------------------------------

        set {_dx} to {_x} - {farrace.start.x}

        set {_dz} to {_z} - {farrace.start.z}


        # ----------------------------------------------------
        # Distance
        # ----------------------------------------------------

        set {_distance} to sqrt(({_dx} * {_dx}) + ({_dz} * {_dz}))

        set {_distanceInt} to floor({_distance})


        # ----------------------------------------------------
        # Console Log
        # ----------------------------------------------------

        log "[FarRace DEBUG] Player=%loop-player% Start=(%{farrace.start.x}%,%{farrace.start.y}%,%{farrace.start.z}%) Current=(%{_x}%,%{_y}%,%{_z}%) DX=%{_dx}% DZ=%{_dz}% Distance=%{_distance}% Score=%{_distanceInt}%"


    # --------------------------------------------------------
    # Footer
    # --------------------------------------------------------

    log "[FarRace DEBUG] =========================="
