# ============================================================
# JINRO RPG SYSTEM
# Version : v0.1.03
#
# Minecraft : Java / Paper
# Script    : Skript
#
# MINIMUM TEST VERSION
#
# ============================================================
#
# COMMAND
#
# /jinro init
#   現在のワールドを人狼RPG用に初期化
#
# /jinro uninit
#   人狼RPG環境を解除
#
# /jinro set
#   看板登録モード
#
# /jinro unset
#   看板登録解除モード
#
# /jinro start
#   ゲーム開始
#
# /jinro stop
#   ゲーム強制終了
#
# /jinro reset
#   テスト状態を完全リセット
#
# ============================================================


# ============================================================
# OPTIONS
# ============================================================

options:

    # STARTボタンの下のブロック
    start-block: crying obsidian

    # 最初の昼
    first-day: 30

    # 通常の昼
    day-time: 120

    # 夜
    night-time: 120

    # スケルトン最大数
    skeleton-max: 10

    # 人狼人数
    wolf-count: 1


# ============================================================
# LOAD
# ============================================================

on load:

    set {jinro.running} to false
    set {jinro.phase} to "none"

    set {jinro.setup-mode} to false
    set {jinro.unset-mode} to false

    delete {jinro.players::*}
    delete {jinro.role::*}
    delete {jinro.alive::*}
    delete {jinro.dead::*}

    send "&7[JINRO] v0.1.03 Loaded."


# ============================================================
# COMMAND
# ============================================================

command /jinro [<text>]:

    permission: op

    trigger:

        # ------------------------------------------------------
        # HELP
        # ------------------------------------------------------

        if arg-1 is not set:

            send "&6===== JINRO RPG ====="
            send "&e/jinro init &7- ステージ初期化"
            send "&e/jinro uninit &7- 環境解除"
            send "&e/jinro set &7- 看板登録"
            send "&e/jinro unset &7- 看板解除"
            send "&e/jinro start &7- ゲーム開始"
            send "&e/jinro stop &7- ゲーム終了"
            send "&e/jinro reset &7- テスト状態リセット"
            send "&6===================="
            stop


        # ------------------------------------------------------
        # INIT
        # ------------------------------------------------------

        if arg-1 is "init":

            if {jinro.running} is true:
                send "&c[JINRO] ゲーム中はinitできません。"
                stop

            jinroInit(player)
            stop


        # ------------------------------------------------------
        # UNINIT
        # ------------------------------------------------------

        if arg-1 is "uninit":

            if {jinro.running} is true:
                send "&c[JINRO] ゲーム中はuninitできません。"
                stop

            jinroUninit(player)
            stop


        # ------------------------------------------------------
        # SET
        # ------------------------------------------------------

        if arg-1 is "set":

            if {jinro.running} is true:
                send "&c[JINRO] ゲーム中は設定できません。"
                stop

            set {jinro.setup-mode} to true
            set {jinro.unset-mode} to false

            send "&a[JINRO] 看板登録モード ON"
            send "&7登録したい看板を右クリックしてください。"
            stop


        # ------------------------------------------------------
        # UNSET
        # ------------------------------------------------------

        if arg-1 is "unset":

            if {jinro.running} is true:
                send "&c[JINRO] ゲーム中は設定できません。"
                stop

            set {jinro.setup-mode} to false
            set {jinro.unset-mode} to true

            send "&e[JINRO] 看板解除モード ON"
            send "&7登録済み看板を右クリックしてください。"
            stop


        # ------------------------------------------------------
        # START
        # ------------------------------------------------------

        if arg-1 is "start":

            jinroStart(player)
            stop


        # ------------------------------------------------------
        # STOP
        # ------------------------------------------------------

        if arg-1 is "stop":

            if {jinro.running} is false:
                send "&e[JINRO] ゲームは開始されていません。"
                stop

            jinroStop()
            stop


        # ------------------------------------------------------
        # RESET
        # ------------------------------------------------------

        if arg-1 is "reset":

            if {jinro.running} is true:
                send "&c[JINRO] ゲーム中はresetできません。"
                stop

            jinroReset(player)
            stop


# ============================================================
# INIT
# ============================================================

function jinroInit(p: player):

    set {jinro.world} to world of {_p}

    set {jinro.running} to false
    set {jinro.phase} to "none"

    set {jinro.setup-mode} to false
    set {jinro.unset-mode} to false

    # ----------------------------------------------------------
    # プレイヤーをAdventure
    # ----------------------------------------------------------

    loop all players:

        if world of loop-player is {jinro.world}:

            set gamemode of loop-player to adventure


    # ----------------------------------------------------------
    # 時間
    # ----------------------------------------------------------

    execute console command "execute in %{jinro.world}% run time set day"
    execute console command "execute in %{jinro.world}% run gamerule doDaylightCycle false"


    # ----------------------------------------------------------
    # 天候
    # ----------------------------------------------------------

    execute console command "execute in %{jinro.world}% run weather clear"
    execute console command "execute in %{jinro.world}% run gamerule doWeatherCycle false"


    # ----------------------------------------------------------
    # モブ
    # ----------------------------------------------------------

    execute console command "execute in %{jinro.world}% run gamerule doMobSpawning false"

    execute console command "execute in %{jinro.world}% run kill @e[type=!player]"


    # ----------------------------------------------------------
    # スコアボード
    # ----------------------------------------------------------

    jinroUpdateLobbyScoreboard({_p})


    send "&a================================" to {_p}
    send "&a[JINRO] ステージを初期化しました。" to {_p}
    send "&fWorld          : %{jinro.world}%" to {_p}
    send "&fAdventure      : ON" to {_p}
    send "&fDaylight Cycle : OFF" to {_p}
    send "&fWeather Cycle  : OFF" to {_p}
    send "&fMob Spawning   : OFF" to {_p}
    send "&a================================" to {_p}


# ============================================================
# UNINIT
# ============================================================

function jinroUninit(p: player):

    if {jinro.world} is not set:

        send "&c[JINRO] 初期化されたワールドがありません。" to {_p}
        stop


    jinroRemoveSkeletons()

    execute console command "bossbar remove jinro:main"

    execute console command "execute in %{jinro.world}% run gamerule doDaylightCycle true"
    execute console command "execute in %{jinro.world}% run gamerule doWeatherCycle true"
    execute console command "execute in %{jinro.world}% run gamerule doMobSpawning true"


    loop all players:

        if world of loop-player is {jinro.world}:

            set gamemode of loop-player to survival


    execute console command "scoreboard objectives setdisplay sidebar"

    execute console command "scoreboard objectives remove jinro_lobby"


    set {jinro.running} to false
    set {jinro.phase} to "none"

    set {jinro.setup-mode} to false
    set {jinro.unset-mode} to false

    delete {jinro.world}


    send "&e[JINRO] 人狼RPG環境を解除しました。" to {_p}


# ============================================================
# RESET
# ============================================================

function jinroReset(p: player):

    # ----------------------------------------------------------
    # モード解除
    # ----------------------------------------------------------

    set {jinro.setup-mode} to false
    set {jinro.unset-mode} to false

    set {jinro.running} to false
    set {jinro.phase} to "none"


    # ----------------------------------------------------------
    # Bossbar
    # ----------------------------------------------------------

    execute console command "bossbar remove jinro:main"


    # ----------------------------------------------------------
    # Skeleton
    # ----------------------------------------------------------

    jinroRemoveSkeletons()


    # ----------------------------------------------------------
    # プレイヤー関連データ
    # ----------------------------------------------------------

    delete {jinro.players::*}
    delete {jinro.role::*}
    delete {jinro.alive::*}
    delete {jinro.dead::*}


    # ----------------------------------------------------------
    # 参加者登録
    # ----------------------------------------------------------

    delete {jinro.participant::*}
    delete {jinro.player-sign::*}
    delete {jinro.sign::*}


    # ----------------------------------------------------------
    # START BUTTON
    # ----------------------------------------------------------

    if {jinro.start-buttons::*} is set:

        loop {jinro.start-buttons::*}:

            set block at loop-value to stone button

    delete {jinro.start-buttons::*}


    # ----------------------------------------------------------
    # SCOREBOARD
    # ----------------------------------------------------------

    execute console command "scoreboard objectives setdisplay sidebar"
    execute console command "scoreboard objectives remove jinro_lobby"


    # ----------------------------------------------------------
    # 看板をリセット
    #
    # 保存していた看板位置を使って初期化
    # ----------------------------------------------------------

    # player-sign は既に削除したので
    # ここでは看板情報を残したまま処理する必要がある。
    #
    # よって reset では看板自体を検索して
    # 上にあるプレイヤーヘッドを削除する。

    if {jinro.world} is set:

        loop all players:

            if world of loop-player is {jinro.world}:

                set gamemode of loop-player to adventure


    send "&e[JINRO] テスト状態をリセットしました。" to {_p}
    send "&7参加者登録・ゲーム状態・ボタン登録を初期化しました。" to {_p}
    send "&7もう一度 /jinro set からテストできます。" to {_p}


# ============================================================
# SIGN EVENT
# ============================================================

on right click:

    # ----------------------------------------------------------
    # 看板かどうか
    # ----------------------------------------------------------

    if "%type of clicked block%" contains "sign":

        # ------------------------------------------------------
        # SET MODE
        # ------------------------------------------------------

        if {jinro.setup-mode} is true:

            cancel event

            if {jinro.running} is true:
                stop


            set {_uuid} to uuid of player


            # --------------------------------------------------
            # 既に登録済み
            # --------------------------------------------------

            if {jinro.participant::%{_uuid}%} is true:

                # 同じ看板なら何もしない
                if {jinro.player-sign::%{_uuid}%} is location of clicked block:

                    send "&e[JINRO] すでにこの看板に登録されています。"
                    stop


                # 古い看板
                set {_old-location} to {jinro.player-sign::%{_uuid}%}

                if {_old-location} is set:

                    set block above block at {_old-location} to air

                    set line 1 of block at {_old-location} to "人狼RPG"
                    set line 2 of block at {_old-location} to ""
                    set line 3 of block at {_old-location} to ""
                    set line 4 of block at {_old-location} to ""

                    delete {jinro.sign::%{_old-location}%}


            # --------------------------------------------------
            # 新しい看板を登録
            # --------------------------------------------------

            set {jinro.participant::%{_uuid}%} to true

            set {jinro.sign::%location of clicked block%} to {_uuid}

            set {jinro.player-sign::%{_uuid}%} to location of clicked block


            # --------------------------------------------------
            # 看板
            # --------------------------------------------------

            set line 1 of clicked block to "人狼RPG"
            set line 2 of clicked block to ""
            set line 3 of clicked block to "%name of player%"
            set line 4 of clicked block to ""


            # --------------------------------------------------
            # HEAD
            # --------------------------------------------------

            set block above clicked block to player head


            send "&a[JINRO] &f%name of player% &aを登録しました。"


            if {jinro.world} is set:

                jinroUpdateLobbyScoreboard(player)

            stop


        # ------------------------------------------------------
        # UNSET MODE
        # ------------------------------------------------------

        if {jinro.unset-mode} is true:

            cancel event

            if {jinro.running} is true:
                stop


            set {_uuid} to {jinro.sign::%location of clicked block%}


            if {_uuid} is not set:

                send "&c[JINRO] この看板は登録されていません。"
                stop


            # --------------------------------------------------
            # HEAD削除
            # --------------------------------------------------

            set block above clicked block to air


            # --------------------------------------------------
            # 看板初期化
            # --------------------------------------------------

            set line 1 of clicked block to "人狼RPG"
            set line 2 of clicked block to ""
            set line 3 of clicked block to ""
            set line 4 of clicked block to ""


            # --------------------------------------------------
            # データ削除
            # --------------------------------------------------

            delete {jinro.sign::%location of clicked block%}
            delete {jinro.player-sign::%{_uuid}%}
            delete {jinro.participant::%{_uuid}%}


            send "&e[JINRO] 参加登録を解除しました。"


            if {jinro.world} is set:

                jinroUpdateLobbyScoreboard(player)

            stop


# ============================================================
# START BUTTON
# ============================================================

on right click on stone button:

    if {jinro.running} is true:
        stop


    if {jinro.world} is not set:
        stop


    if world of player is not {jinro.world}:
        stop


    set {_under} to block below event-block


    if type of {_under} is {@start-block}:

        cancel event


        # ------------------------------------------------------
        # ボタン登録
        # ------------------------------------------------------

        if event-block is not in {jinro.start-buttons::*}:

            add event-block to {jinro.start-buttons::*}


        # ------------------------------------------------------
        # ゲーム開始
        # ------------------------------------------------------

        jinroStart(player)


# ============================================================
# START GAME
# ============================================================

function jinroStart(p: player):

    if {jinro.running} is true:

        send "&c[JINRO] すでにゲーム中です。" to {_p}
        stop


    if {jinro.world} is not set:

        send "&c[JINRO] 先に /jinro init を実行してください。" to {_p}
        stop


    # ----------------------------------------------------------
    # 参加者取得
    #
    # participant::* に登録されたUUIDから
    # 現在オンラインのプレイヤーを取得
    # ----------------------------------------------------------

    delete {jinro.players::*}


    loop all players:

        if world of loop-player is {jinro.world}:

            set {_uuid} to uuid of loop-player

            if {jinro.participant::%{_uuid}%} is true:

                add loop-player to {jinro.players::*}


    set {_count} to size of {jinro.players::*}


    # ----------------------------------------------------------
    # 参加者チェック
    # ----------------------------------------------------------

    if {_count} < 1:

        send "&c[JINRO] 参加者がいません。" to {_p}
        stop


    # ----------------------------------------------------------
    # 人狼人数チェック
    # ----------------------------------------------------------

    if {@wolf-count} > {_count}:

        send "&c[JINRO] 人狼人数が参加人数を超えています。" to {_p}
        stop


    # ----------------------------------------------------------
    # ゲーム開始
    # ----------------------------------------------------------

    set {jinro.running} to true
    set {jinro.phase} to "starting"

    set {jinro.setup-mode} to false
    set {jinro.unset-mode} to false


    # ----------------------------------------------------------
    # データ初期化
    # ----------------------------------------------------------

    delete {jinro.role::*}
    delete {jinro.alive::*}
    delete {jinro.dead::*}


    # ----------------------------------------------------------
    # 全員村人
    # ----------------------------------------------------------

    loop {jinro.players::*}:

        set {_uuid} to uuid of loop-value

        set {jinro.role::%{_uuid}%} to "villager"
        set {jinro.alive::%{_uuid}%} to true


    # ----------------------------------------------------------
    # 人狼抽選
    # ----------------------------------------------------------

    set {_wolf} to random element out of {jinro.players::*}

    set {_wolf-uuid} to uuid of {_wolf}

    set {jinro.role::%{_wolf-uuid}%} to "wolf"


    # ----------------------------------------------------------
    # ロビースコアボード削除
    # ----------------------------------------------------------

    jinroRemoveLobbyScoreboard()


    # ----------------------------------------------------------
    # プレイヤー初期化
    # ----------------------------------------------------------

    loop {jinro.players::*}:

        set gamemode of loop-value to survival

        clear inventory of loop-value

        heal loop-value

        set food level of loop-value to 20


        if {jinro.role::%uuid of loop-value%} is "wolf":

            send title "&c人狼" with subtitle "&7あなたは人狼です。" to loop-value for 3 seconds

        else:

            send title "&a村人" with subtitle "&7あなたは村人です。" to loop-value for 3 seconds


    # ----------------------------------------------------------
    # STARTボタン削除
    # ----------------------------------------------------------

    loop {jinro.start-buttons::*}:

        set block at loop-value to air


    wait 3 seconds


    if {jinro.running} is false:
        stop


    jinroDay({@first-day})


# ============================================================
# DAY
# ============================================================

function jinroDay(seconds: number):

    if {jinro.running} is false:
        stop


    set {jinro.phase} to "day"


    jinroRemoveSkeletons()


    execute console command "execute in %{jinro.world}% run time set day"


    loop {jinro.players::*}:

        if {jinro.alive::%uuid of loop-value%} is true:

            send title "&f昼になりました。" with subtitle "" to loop-value for 2 seconds


    jinroRunBossbar({_seconds})


    if {jinro.running} is false:
        stop


    jinroNight({@night-time})


# ============================================================
# NIGHT
# ============================================================

function jinroNight(seconds: number):

    if {jinro.running} is false:
        stop


    set {jinro.phase} to "night"


    execute console command "execute in %{jinro.world}% run time set night"


    loop {jinro.players::*}:

        if {jinro.alive::%uuid of loop-value%} is true:

            send title "&1夜になりました。" with subtitle "" to loop-value for 2 seconds


    jinroSpawnSkeletons()


    jinroRunBossbar({_seconds})


    if {jinro.running} is false:
        stop


    jinroDay({@day-time})


# ============================================================
# BOSSBAR
# ============================================================

function jinroRunBossbar(seconds: number):

    execute console command "bossbar remove jinro:main"

    execute console command "bossbar add jinro:main {""text"":""JINRO RPG""}"

    execute console command "bossbar set jinro:main max %{_seconds}%"

    execute console command "bossbar set jinro:main value %{_seconds}%"

    execute console command "bossbar set jinro:main style progress"

    execute console command "bossbar set jinro:main color white"

    execute console command "bossbar set jinro:main players @a"


    loop {_seconds} times:

        if {jinro.running} is false:

            execute console command "bossbar remove jinro:main"

            stop


        wait 1 second


        set {_remaining} to {_seconds} - loop-number


        if {_remaining} < 0:

            set {_remaining} to 0


        execute console command "bossbar set jinro:main value %{_remaining}%"


    execute console command "bossbar remove jinro:main"


# ============================================================
# SPAWN SKELETON
# ============================================================

function jinroSpawnSkeletons():

    if {jinro.running} is false:
        stop

    if {jinro.phase} is not "night":
        stop


    set {_count} to number of all skeletons in {jinro.world}


    if {_count} >= {@skeleton-max}:
        stop


    set {_need} to {@skeleton-max} - {_count}


    if {_need} > 5:

        set {_need} to 5


    loop {_need} times:

        set {_target} to random element out of {jinro.players::*}


        if {_target} is set:

            execute console command "execute at %{_target}% run summon minecraft:skeleton ~ ~ ~ {PersistenceRequired:1b,Tags:[""jinro_skeleton""]}"


# ============================================================
# SKELETON DEATH
# ============================================================

on death of skeleton:

    if {jinro.running} is false:
        stop

    if {jinro.phase} is not "night":
        stop

    if "%tags of victim%" does not contain "jinro_skeleton":
        stop


    clear drops


    if attacker is a player:

        if chance of 50%:

            give 1 emerald to attacker

            send "&aエメラルドを獲得しました。" to attacker


# ============================================================
# PLAYER DEATH
# ============================================================

on death of player:

    if {jinro.running} is false:
        stop


    set {_uuid} to uuid of victim


    if {jinro.alive::%{_uuid}%} is not true:
        stop


    set {jinro.alive::%{_uuid}%} to false
    set {jinro.dead::%{_uuid}%} to true


    clear drops


    send "&c死亡しました。" to victim


# ============================================================
# PLAYER DROP
# ============================================================

on drop:

    if {jinro.running} is true:

        if player is in {jinro.players::*}:

            cancel event


# ============================================================
# BLOCK BREAK
# ============================================================

on break:

    if {jinro.running} is true:

        if world of player is {jinro.world}:

            cancel event


# ============================================================
# BLOCK PLACE
# ============================================================

on place:

    if {jinro.running} is true:

        if world of player is {jinro.world}:

            cancel event


# ============================================================
# MOB SPAWN
# ============================================================

on spawn of monster:

    if {jinro.world} is not set:
        stop


    if world of event-entity is not {jinro.world}:
        stop


    if {jinro.running} is false:

        cancel event
        stop


    if {jinro.phase} is not "night":

        cancel event
        stop


    if event-entity is not skeleton:

        cancel event


# ============================================================
# WIN CHECK
# ============================================================

every 1 second:

    if {jinro.running} is false:
        stop


    if size of {jinro.players::*} <= 1:
        stop


    set {_wolves} to 0
    set {_villagers} to 0


    loop {jinro.players::*}:

        set {_uuid} to uuid of loop-value


        if {jinro.alive::%{_uuid}%} is true:

            if {jinro.role::%{_uuid}%} is "wolf":

                add 1 to {_wolves}

            else:

                add 1 to {_villagers}


    if {_wolves} <= 0:

        jinroWin("villager")
        stop


    if {_villagers} <= 0:

        jinroWin("wolf")
        stop


# ============================================================
# WIN
# ============================================================

function jinroWin(winner: text):

    if {jinro.running} is false:
        stop


    set {jinro.running} to false
    set {jinro.phase} to "result"


    jinroRemoveSkeletons()

    execute console command "bossbar remove jinro:main"

    execute console command "execute in %{jinro.world}% run time set day"


    if {_winner} is "wolf":

        loop {jinro.players::*}:

            send title "&c人狼の勝利" with subtitle "" to loop-value for 4 seconds

    else:

        loop {jinro.players::*}:

            send title "&a村人の勝利" with subtitle "" to loop-value for 4 seconds


    wait 4 seconds


    # ----------------------------------------------------------
    # 役職開示
    # ----------------------------------------------------------

    loop {jinro.players::*}:

        if {jinro.role::%uuid of loop-value%} is "wolf":

            broadcast "&c%name of loop-value% &7→ &c人狼"

        else:

            broadcast "&a%name of loop-value% &7→ &a村人"


    # ----------------------------------------------------------
    # Adventure
    # ----------------------------------------------------------

    loop {jinro.players::*}:

        set gamemode of loop-value to adventure


    # ----------------------------------------------------------
    # データ削除
    # ----------------------------------------------------------

    delete {jinro.alive::*}
    delete {jinro.dead::*}
    delete {jinro.role::*}


    set {jinro.phase} to "none"


    jinroRestoreStartButtons()


    if {jinro.world} is set:

        jinroUpdateLobbyScoreboardFromWorld()


# ============================================================
# STOP
# ============================================================

function jinroStop():

    set {jinro.running} to false
    set {jinro.phase} to "stopped"


    jinroRemoveSkeletons()

    execute console command "bossbar remove jinro:main"


    if {jinro.world} is set:

        execute console command "execute in %{jinro.world}% run time set day"


    loop {jinro.players::*}:

        set gamemode of loop-value to adventure

        send title "&cゲーム終了" with subtitle "&7ゲームを終了しました。" to loop-value for 3 seconds


    loop {jinro.players::*}:

        if {jinro.role::%uuid of loop-value%} is "wolf":

            broadcast "&c%name of loop-value% &7→ &c人狼"

        else:

            broadcast "&a%name of loop-value% &7→ &a村人"


    delete {jinro.alive::*}
    delete {jinro.dead::*}
    delete {jinro.role::*}


    jinroRestoreStartButtons()


    if {jinro.world} is set:

        jinroUpdateLobbyScoreboardFromWorld()


    set {jinro.phase} to "none"


    broadcast "&e[JINRO] ゲームを終了しました。"


# ============================================================
# REMOVE SKELETONS
# ============================================================

function jinroRemoveSkeletons():

    if {jinro.world} is not set:
        stop

    execute console command "execute in %{jinro.world}% run kill @e[type=minecraft:skeleton,tag=jinro_skeleton]"


# ============================================================
# RESTORE START BUTTON
# ============================================================

function jinroRestoreStartButtons():

    if {jinro.world} is not set:
        stop


    loop {jinro.start-buttons::*}:

        set block at loop-value to stone button


# ============================================================
# LOBBY SCOREBOARD
# ============================================================

function jinroUpdateLobbyScoreboard(p: player):

    if {jinro.world} is not set:
        stop


    set {_count} to 0


    loop all players:

        set {_uuid} to uuid of loop-player

        if {jinro.participant::%{_uuid}%} is true:

            add 1 to {_count}


    execute console command "scoreboard objectives remove jinro_lobby"
    execute console command "scoreboard objectives add jinro_lobby dummy ""JINRO RPG"""
    execute console command "scoreboard objectives setdisplay sidebar jinro_lobby"

    execute console command "scoreboard players set ""Participants"" jinro_lobby %{_count}%"
    execute console command "scoreboard players set ""Werewolves"" jinro_lobby 1"


# ============================================================
# LOBBY SCOREBOARD UPDATE
# ============================================================

function jinroUpdateLobbyScoreboardFromWorld():

    if {jinro.world} is not set:
        stop


    set {_count} to 0


    loop all players:

        if world of loop-player is {jinro.world}:

            set {_uuid} to uuid of loop-player

            if {jinro.participant::%{_uuid}%} is true:

                add 1 to {_count}


    execute console command "scoreboard objectives remove jinro_lobby"
    execute console command "scoreboard objectives add jinro_lobby dummy ""JINRO RPG"""
    execute console command "scoreboard objectives setdisplay sidebar jinro_lobby"

    execute console command "scoreboard players set ""Participants"" jinro_lobby %{_count}%"
    execute console command "scoreboard players set ""Werewolves"" jinro_lobby 1"


# ============================================================
# REMOVE LOBBY SCOREBOARD
# ============================================================

function jinroRemoveLobbyScoreboard():

    execute console command "scoreboard objectives setdisplay sidebar"
    execute console command "scoreboard objectives remove jinro_lobby"
