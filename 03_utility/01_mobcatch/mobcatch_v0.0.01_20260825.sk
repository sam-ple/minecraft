# ============================================================
# MOB CAPTURE SYSTEM
# Minimal Test Version
#
# 目的：
#   Mob捕獲システムを作る前に、
#   「右クリック → 近くの豚を捕獲 → スポーンエッグ取得」
#   がSkript単体で正常に動作するか確認する。
#
# 対象Mob：
#   豚（Pig）のみ
#
# 捕獲アイテム：
#   ニンジン付きの棒（Carrot on a Stick）
#
# コマンド：
#   /capture start
#       テスト開始
#
#   /capture stop
#       テスト停止
#
#   /capture reset
#       テスト状態をリセット
#
# ============================================================


# ============================================================
# OPTIONS
# ============================================================

options:

    # --------------------------------------------------------
    # 捕獲に使用するアイテム
    # --------------------------------------------------------

    capture-item: carrot on a stick


# ============================================================
# LOAD
# ============================================================

on load:

    # Skriptの読み込み確認用
    send "[Mob Capture] Minimal Test Version Loaded." to console


# ============================================================
# CAPTURE CONTROL COMMAND
# ============================================================

command /capture [<text>]:

    # OPのみ使用可能
    permission: op

    trigger:

        # ----------------------------------------------------
        # START
        # ----------------------------------------------------
        #
        # 捕獲テストを開始する。
        #
        # {capture.test} が true の間だけ
        # 右クリック捕獲処理が動作する。
        # ----------------------------------------------------

        if arg-1 is "start":

            set {capture.test} to true

            send "&a================================" to player
            send "&a[Mob Capture] TEST START" to player
            send "&aニンジン付きの棒で豚を右クリックしてください。" to player
            send "&a================================" to player

            stop


        # ----------------------------------------------------
        # STOP
        # ----------------------------------------------------
        #
        # 捕獲テストを停止する。
        #
        # 豚を右クリックしても何も起こらなくなる。
        # ----------------------------------------------------

        if arg-1 is "stop":

            set {capture.test} to false

            send "&c================================" to player
            send "&c[Mob Capture] TEST STOP" to player
            send "&c================================" to player

            stop


        # ----------------------------------------------------
        # RESET
        # ----------------------------------------------------
        #
        # テスト用変数を削除する。
        #
        # 今回は最小構成なので、
        # {capture.test} のみを削除する。
        # ----------------------------------------------------

        if arg-1 is "reset":

            delete {capture.test}

            send "&e================================" to player
            send "&e[Mob Capture] TEST RESET" to player
            send "&e================================" to player

            stop


        # ----------------------------------------------------
        # HELP
        # ----------------------------------------------------

        send "&e================================" to player
        send "&eMob Capture Test" to player
        send "&e/capture start &7- テスト開始" to player
        send "&e/capture stop &7- テスト停止" to player
        send "&e/capture reset &7- テストリセット" to player
        send "&e================================" to player


# ============================================================
# RIGHT CLICK
# ============================================================
#
# ニンジン付きの棒を持って右クリックしたときの処理。
#
# 今回は「視線判定」はまだ実装しない。
#
# プレイヤーの近くにいる豚を1匹取得し、
# その豚を捕獲対象とする。
#
# ============================================================

on right click:

    # --------------------------------------------------------
    # テストが開始されていない場合
    # --------------------------------------------------------

    if {capture.test} is not true:
        stop


    # --------------------------------------------------------
    # 捕獲アイテム確認
    # --------------------------------------------------------
    #
    # ニンジン付きの棒を持っている場合のみ処理する。
    # --------------------------------------------------------

    if player's tool is not {@capture-item}:
        stop


    # --------------------------------------------------------
    # 近くの豚を取得
    # --------------------------------------------------------
    #
    # プレイヤーから最も近い豚を1匹取得する。
    #
    # ここではまだ、
    # 「プレイヤーが見ている豚」
    # という判定は行わない。
    #
    # あくまで最小テストとして、
    # 「近くの豚を取得できるか」
    # を確認する。
    # --------------------------------------------------------

    set {_pig} to nearest pig to player


    # --------------------------------------------------------
    # 豚が存在しない場合
    # --------------------------------------------------------

    if {_pig} is not set:

        send "&c近くに豚がいません。" to player

        stop


    # --------------------------------------------------------
    # 距離確認
    # --------------------------------------------------------
    #
    # あまり遠い豚まで捕獲しないようにする。
    #
    # 今回のテストでは5ブロック以内。
    # --------------------------------------------------------

    if distance between player and {_pig} > 5:

        send "&c豚が遠すぎます。" to player

        stop


    # ========================================================
    # CAPTURE
    # ========================================================

    # --------------------------------------------------------
    # 豚を削除
    # --------------------------------------------------------
    #
    # 本番ではここで、
    # ・捕獲演出
    # ・パーティクル
    # ・効果音
    # ・Y=-64への移動
    # ・Kill
    # などを追加する。
    #
    # 今回は最小テストなので単純にkillする。
    # --------------------------------------------------------

    kill {_pig}


    # --------------------------------------------------------
    # スポーンエッグを取得
    # --------------------------------------------------------
    #
    # 捕獲した豚に対応する
    # 豚のスポーンエッグを1個渡す。
    # --------------------------------------------------------

    give 1 pig spawn egg to player


    # --------------------------------------------------------
    # 成功メッセージ
    # --------------------------------------------------------

    send "&aPigを捕獲しました！" to player
