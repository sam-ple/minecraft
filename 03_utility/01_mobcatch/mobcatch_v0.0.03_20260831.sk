        set {_mob-name} to "Zoglin"


    else if {_target} is a zombie:

        set {_egg} to zombie spawn egg
        set {_mob-name} to "Zombie"


    else if {_target} is a zombie horse:

        set {_egg} to zombie horse spawn egg
        set {_mob-name} to "Zombie Horse"


    else if {_target} is a zombified piglin:

        set {_egg} to zombified piglin spawn egg
        set {_mob-name} to "Zombified Piglin"


    else if {_target} is a zombie villager:

        set {_egg} to zombie villager spawn egg
        set {_mob-name} to "Zombie Villager"


    # ========================================================
    # 未対応
    # ========================================================

    else:

        send "&cこのMobは捕獲対象外です。" to player

        stop


    # ========================================================
    # CAPTURE EFFECT
    # ========================================================

    # --------------------------------------------------------
    # ポータルパーティクル
    # --------------------------------------------------------

    execute console command "particle minecraft:portal %x-coordinate of {_target}% %y-coordinate of {_target}% %z-coordinate of {_target}% 0.5 0.8 0.5 0.2 50"


    # --------------------------------------------------------
    # 効果音
    # --------------------------------------------------------

    play sound "entity.enderman.teleport" with volume 1 and pitch 1 to player


    # --------------------------------------------------------
    # 捕獲メッセージ
    # --------------------------------------------------------

    send "&a[Mob Capture] &f%{_mob-name}% &aを捕獲しました！" to player


    # ========================================================
    # REMOVE MOB
    # ========================================================

    # --------------------------------------------------------
    # 現在位置を取得
    # --------------------------------------------------------

    set {_capture-location} to location of {_target}

    # --------------------------------------------------------
    # Y座標だけ変更
    # --------------------------------------------------------

    set y-coordinate of {_capture-location} to {@capture-y}

    # --------------------------------------------------------
    # Y=-64へ移動
    # --------------------------------------------------------

    teleport {_target} to {_capture-location}

    # --------------------------------------------------------
    # Kill
    # --------------------------------------------------------

    kill {_target}


    # ========================================================
    # GIVE SPAWN EGG
    # ========================================================

    give 1 of {_egg} to player


    # --------------------------------------------------------
    # 完了
    # --------------------------------------------------------

    send "&e→ %{_mob-name}% Spawn Egg ×1" to player
