# ============================================================
# MOB CAPTURE SYSTEM
# Version : v1.0.01
#
# Minecraft Java Edition + Paper + Skript
#
# ============================================================
#
# PURPOSE
#
#   ウィザースターを持ってMobを右クリックすると、
#   そのMobを捕獲してスポーンエッグを取得する。
#
# ============================================================
#
# CAPTURE FLOW
#
#   ウィザースターでMobを右クリック
#             ↓
#   5ブロック以内か確認
#             ↓
#   捕獲可能Mobか確認
#             ↓
#   捕獲演出
#             ↓
#   MobをY=-64へ移動
#             ↓
#   MobをKill
#             ↓
#   対応するSpawn Eggを1個取得
#
# ============================================================
#
# COMMANDS
#
#   /capture start
#       捕獲機能ON
#
#   /capture stop
#       捕獲機能OFF
#
#   /capture reset
#       状態リセット
#
#   /capture status
#       状態確認
#
#   /capture
#       ヘルプ
#
# ============================================================


# ============================================================
# OPTIONS
# ============================================================

options:

    # --------------------------------------------------------
    # 捕獲アイテム
    # --------------------------------------------------------

    capture-item: nether star
    # capture-item: stick
    # capture-item: brush
    # capture-item: glass bottle
    # capture-item-name: 

    # --------------------------------------------------------
    # 捕獲距離
    # --------------------------------------------------------

    capture-distance: 5

    # --------------------------------------------------------
    # 捕獲後の退避Y座標
    # --------------------------------------------------------

    capture-y: -64


# ============================================================
# LOAD
# ============================================================

on load:

    send "[Mob Capture] v1.0.01 Loaded." to console


# ============================================================
# COMMAND
# ============================================================

command /capture [<text>]:

    permission: op

    trigger:


        # ====================================================
        # START
        # ====================================================

        if arg-1 is "start":

            set {capture.enabled} to true

            send "&a================================" to player
            send "&a[Mob Capture] START" to player
            send "&a捕獲機能を開始しました。" to player
            send "&7捕獲アイテム：ウィザースター" to player
            send "&7捕獲距離：{@capture-distance}ブロック" to player
            send "&a================================" to player

            stop


        # ====================================================
        # STOP
        # ====================================================

        if arg-1 is "stop":

            set {capture.enabled} to false

            send "&c================================" to player
            send "&c[Mob Capture] STOP" to player
            send "&c捕獲機能を停止しました。" to player
            send "&c================================" to player

            stop


        # ====================================================
        # RESET
        # ====================================================

        if arg-1 is "reset":

            delete {capture.enabled}

            send "&e================================" to player
            send "&e[Mob Capture] RESET" to player
            send "&e状態をリセットしました。" to player
            send "&e================================" to player

            stop


        # ====================================================
        # STATUS
        # ====================================================

        if arg-1 is "status":

            if {capture.enabled} is true:

                send "&a[Mob Capture] ON" to player

            else:

                send "&c[Mob Capture] OFF" to player

            stop


        # ====================================================
        # HELP
        # ====================================================

        send "&e================================" to player
        send "&eMob Capture System v1.0.01" to player
        send "" to player
        send "&e/capture start &7- 捕獲開始" to player
        send "&e/capture stop &7- 捕獲停止" to player
        send "&e/capture reset &7- 状態リセット" to player
        send "&e/capture status &7- 状態確認" to player
        send "&e================================" to player


# ============================================================
# RIGHT CLICK
# ============================================================

on right click:


    # --------------------------------------------------------
    # システムOFF
    # --------------------------------------------------------

    if {capture.enabled} is not true:

        stop


    # --------------------------------------------------------
    # 捕獲アイテム確認
    # --------------------------------------------------------

    if player's tool is not {@capture-item}:

        stop


    # --------------------------------------------------------
    # クリックしたEntity
    # --------------------------------------------------------

    set {_target} to clicked entity


    # --------------------------------------------------------
    # Entityが存在しない
    # --------------------------------------------------------

    if {_target} is not set:

        stop


    # --------------------------------------------------------
    # Living Entityのみ
    # --------------------------------------------------------

    if {_target} is not a living entity:

        stop


    # --------------------------------------------------------
    # Player除外
    # --------------------------------------------------------

    if {_target} is a player:

        stop


    # --------------------------------------------------------
    # 距離確認
    # --------------------------------------------------------

    if distance between player and {_target} > {@capture-distance}:

        send "&cMobが遠すぎます。" to player

        stop


    # ========================================================
    # MOB → SPAWN EGG
    # ========================================================

    if {_target} is an allay:

        set {_egg} to allay spawn egg
        set {_mob-name} to "Allay"


    else if {_target} is an armadillo:

        set {_egg} to armadillo spawn egg
        set {_mob-name} to "Armadillo"


    else if {_target} is an axolotl:

        set {_egg} to axolotl spawn egg
        set {_mob-name} to "Axolotl"


    else if {_target} is a bat:

        set {_egg} to bat spawn egg
        set {_mob-name} to "Bat"


    else if {_target} is a bee:

        set {_egg} to bee spawn egg
        set {_mob-name} to "Bee"


    else if {_target} is a blaze:

        set {_egg} to blaze spawn egg
        set {_mob-name} to "Blaze"


    else if {_target} is a bogged:

        set {_egg} to bogged spawn egg
        set {_mob-name} to "Bogged"


    else if {_target} is a breeze:

        set {_egg} to breeze spawn egg
        set {_mob-name} to "Breeze"


    else if {_target} is a camel:

        set {_egg} to camel spawn egg
        set {_mob-name} to "Camel"


    else if {_target} is a cat:

        set {_egg} to cat spawn egg
        set {_mob-name} to "Cat"


    else if {_target} is a cave spider:

        set {_egg} to cave spider spawn egg
        set {_mob-name} to "Cave Spider"


