# ============================================================
# MOB CAPTURE SYSTEM
#
# Minescript版をSkriptへ移植
#
# 機能
# ・にんじん付きの棒を持って視線の先のMobを検出
# ・対象MobをGlowing表示
# ・ハッピービレジャーパーティクル
# ・右クリックでMobを捕獲
# ・対応するスポーンエッグを1個取得
# ・ポータルパーティクル
# ・エンダーマンテレポート音
# ・Mobのドロップを無効化
# ・MobをY=-64へ退避してからkill
# ・全プレイヤー対応
#
# 必要:
# Paper
# Skript
#
# ============================================================


# ============================================================
# 設定
# ============================================================

options:

    # 捕獲に使用するアイテム
    capture-item: carrot on a stick

    # 視線判定距離
    capture-distance: 1.5

    # 視線判定の更新間隔
    # 10 ticks = 0.5秒
    scan-interval: 10

    # 捕獲対象Mobを退避させるY座標
    capture-y: -64


# ============================================================
# 初期化
# ============================================================

on load:

    send "&a[Mob Capture] &fLoaded." to console


# ============================================================
# 視線判定
#
# 全プレイヤーについて、
# にんじん付きの棒を持っている場合のみ視線判定を行う。
#
# 元Minescriptの
#
#   anchored eyes
#   positioned ^ ^ ^1.5
#
# をそのまま利用。
# ============================================================

every {@scan-interval} ticks:

    loop all players:

        set {_player} to loop-player

        # ----------------------------------------------------
        # 捕獲アイテムを持っていなければ対象解除
        # ----------------------------------------------------

        if {_player}'s tool is not {@capture-item}:

            if {capture.target::%uuid of {_player}%} is set:

                delete {capture.target::%uuid of {_player}%}

            continue


        # ----------------------------------------------------
        # 前回の対象を解除
        # ----------------------------------------------------

        set {_oldTarget} to {capture.target::%uuid of {_player}%}

        if {_oldTarget} is set:

            if {_oldTarget} is alive:

                execute console command "effect clear %uuid of {_oldTarget}% minecraft:glowing"

            delete {capture.target::%uuid of {_player}%}


        # ----------------------------------------------------
        # プレイヤー固有タグ
        #
        # UUIDをタグ名として使用。
        # UUIDにはハイフンが入るため、
        # Minecraftタグとして扱いやすいように削除。
        # ----------------------------------------------------

        set {_uuid} to "%uuid of {_player}%"
        replace all "-" with "" in {_uuid}

        set {_tag} to "capture_%{_uuid}%"


        # ----------------------------------------------------
        # 念のため前回タグを削除
        # ----------------------------------------------------

        execute console command "tag @e[tag=%{_tag}%] remove %{_tag}%"


        # ----------------------------------------------------
        # 視線先のMobを検出
        #
        # 元Minescriptと同じ考え方。
        #
        # eyes
        # ↓
        # ^ ^ ^1.5
        # ↓
        # 半径2以内
        # ↓
        # 最も近い対象Mob
        # ----------------------------------------------------

        execute console command "execute as %{_player}% at %{_player}% anchored eyes positioned ^ ^ ^{@capture-distance} if entity @e[type=!player,type=!armor_stand,type=!item,type=!item_frame,type=!minecart,distance=..2] run tag @e[type=!player,type=!armor_stand,type=!item,type=!item_frame,type=!minecart,limit=1,sort=nearest,distance=..2] add %{_tag}%"


        # ----------------------------------------------------
        # タグ付きMobを取得
        # ----------------------------------------------------

        loop all entities:

            if loop-entity has tag "%{_tag}%":

                set {capture.target::%uuid of {_player}%} to loop-entity

                # --------------------------------------------
                # Glowing
                # --------------------------------------------

                apply glowing 1 to loop-entity


                # --------------------------------------------
                # パーティクル
                # --------------------------------------------

                play particle happy villager at loop-entity with offset vector(0.2, 0.2, 0.2) and speed 0 and count 3


                # --------------------------------------------
                # 一人のプレイヤーにつき1対象だけ
                # --------------------------------------------

                stop loop


        # ----------------------------------------------------
        # 一時タグを削除
        # ----------------------------------------------------

        execute console command "tag @e[tag=%{_tag}%] remove %{_tag}%"


# ============================================================
# 右クリック捕獲
# ============================================================

on right click:

    # --------------------------------------------------------
    # にんじん付きの棒以外は無視
    # --------------------------------------------------------

    if player's tool is not {@capture-item}:
        stop


    # --------------------------------------------------------
    # 右クリックイベントをキャンセル
    # --------------------------------------------------------

    cancel event


    # --------------------------------------------------------
    # 現在のターゲット取得
    # --------------------------------------------------------

    set {_target} to {capture.target::%uuid of player%}


    # --------------------------------------------------------
    # ターゲットが存在しない
    # --------------------------------------------------------

    if {_target} is not set:

        send "&c捕獲対象がありません。" to player

        stop


    # --------------------------------------------------------
    # Mobがすでに死亡している場合
    # --------------------------------------------------------

    if {_target} is dead:

        delete {capture.target::%uuid of player%}

        stop


    # --------------------------------------------------------
    # プレイヤー自身・不正な対象を防止
    # --------------------------------------------------------

    if {_target} is a player:

        delete {capture.target::%uuid of player%}

        stop


    if {_target} is an armor stand:

        delete {capture.target::%uuid of player%}

        stop


    # ========================================================
    # Mob種類取得
    # ========================================================

    set {_type} to "%type of {_target}%"

    # Minecraft ID用に整形
    replace all " " with "_" in {_type}


    # ========================================================
    # 対応スポーンエッグ
    #
    # Minecraft 1.21.x
    #
    # entity type
    #       ↓
    # minecraft:<entity>_spawn_egg
    #
    # という形式を利用。
    # ========================================================

    set {_egg} to "minecraft:%{_type}%_spawn_egg"


    # --------------------------------------------------------
    # スポーンエッグが存在するMobか確認
    #
    # 対応外のMobについては捕獲しない。
    # --------------------------------------------------------

    if {_type} is not one of:

        "allay",
        "armadillo",
        "axolotl",
        "bat",
        "bee",
        "blaze",
        "bogged",
        "breeze",
        "camel",
        "cat",
        "cave_spider",
        "chicken",
        "cod",
        "cow",
        "creaking",
        "creeper",
        "dolphin",
        "donkey",
        "drowned",
        "elder_guardian",
        "ender_dragon",
        "enderman",
        "endermite",
        "evoker",
        "fox",
        "frog",
        "ghast",
        "glow_squid",
        "goat",
        "guardian",
        "hoglin",
        "horse",
        "husk",
        "iron_golem",
        "llama",
        "magma_cube",
        "mooshroom",
        "mule",
        "ocelot",
        "panda",
        "parrot",
        "phantom",
        "pig",
        "piglin",
        "piglin_brute",
        "pillager",
        "polar_bear",
        "pufferfish",
        "rabbit",
        "ravager",
        "salmon",
        "sheep",
        "shulker",
        "silverfish",
        "skeleton",
        "skeleton_horse",
        "slime",
        "sniffer",
        "snow_golem",
        "spider",
        "stray",
        "strider",
        "tadpole",
        "trader_llama",
        "tropical_fish",
        "turtle",
        "vex",
        "vindicator",
        "villager",
        "wandering_trader",
        "warden",
        "witch",
        "wither",
        "wither_skeleton",
        "wolf",
        "zoglin",
        "zombie",
        "zombie_horse",
        "zombified_piglin",
        "zombie_villager"

        send "&cこのMobは捕獲できません。" to player

        delete {capture.target::%uuid of player%}

        stop


    # ========================================================
    # 捕獲処理開始
    # ========================================================

    set {_mobname} to {_type}


    # --------------------------------------------------------
    # スポーンエッグ取得
    # --------------------------------------------------------

    execute console command "give %player% %{_egg}% 1"


    # --------------------------------------------------------
    # 捕獲メッセージ
    # --------------------------------------------------------

    send "&6%player% &aが &e%{_mobname}% &aを捕獲しました！" to all players


    # --------------------------------------------------------
    # ポータルパーティクル
    # --------------------------------------------------------

    play particle portal at {_target} with offset vector(0.5, 0.5, 0.5) and speed 0.2 and count 50


    # --------------------------------------------------------
    # 効果音
    # --------------------------------------------------------

    play sound "entity.enderman.teleport" with volume 1 and pitch 1 at player


    # --------------------------------------------------------
    # ドロップ無効化
    #
    # killする前にloot tableを空にする。
    # --------------------------------------------------------

    execute console command "data merge entity %uuid of {_target}% {DeathLootTable:""minecraft:empty"",HandItems:[],ArmorItems:[]}"


    # --------------------------------------------------------
    # Y=-64へ退避
    # --------------------------------------------------------

    set {_loc} to location of {_target}

    set y-coordinate of {_loc} to {@capture-y}

    teleport {_target} to {_loc}


    # --------------------------------------------------------
    # Mob削除
    # --------------------------------------------------------

    kill {_target}


    # --------------------------------------------------------
    # ターゲット情報削除
    # --------------------------------------------------------

    delete {capture.target::%uuid of player%}


# ============================================================
# プレイヤー退出時の後処理
# ============================================================

on quit:

    delete {capture.target::%uuid of player%}


# ============================================================
# 管理用コマンド
# ============================================================

command /capture [<text>]:

    permission: op

    trigger:

        if arg-1 is "reload":

            send "&a[Mob Capture] &f設定を再読み込みします。"

            execute console command "sk reload %script%"

            stop


        if arg-1 is "clear":

            delete {capture.target::*}

            send "&a[Mob Capture] &f全プレイヤーの捕獲対象をリセットしました。"

            stop


        send "&e/capture reload &7- Skriptを再読み込み"
        send "&e/capture clear &7- 全ターゲットをリセット"