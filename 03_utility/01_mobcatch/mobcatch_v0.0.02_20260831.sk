    # --------------------------------------------------------

    else if {_target} is a bee:

        set {_egg} to bee spawn egg
        set {_mob-name} to "Bee"


    # --------------------------------------------------------
    # 村人
    # --------------------------------------------------------

    else if {_target} is a villager:

        set {_egg} to villager spawn egg
        set {_mob-name} to "Villager"


    # --------------------------------------------------------
