    # --------------------------------------------------------

    else if {_target} is a skeleton:

        set {_egg} to skeleton spawn egg
        set {_mob-name} to "Skeleton"


    # --------------------------------------------------------
    # クリーパー
    # --------------------------------------------------------

    else if {_target} is a creeper:

        set {_egg} to creeper spawn egg
        set {_mob-name} to "Creeper"


    # --------------------------------------------------------
    # クモ
    # --------------------------------------------------------

    else if {_target} is a spider:

        set {_egg} to spider spawn egg
        set {_mob-name} to "Spider"


    # --------------------------------------------------------
    # 洞窟グモ
    # --------------------------------------------------------

    else if {_target} is a cave spider:

        set {_egg} to cave spider spawn egg
        set {_mob-name} to "Cave Spider"


    # --------------------------------------------------------
    # エンダーマン
    # --------------------------------------------------------

    else if {_target} is an enderman:

        set {_egg} to enderman spawn egg
        set {_mob-name} to "Enderman"


    # --------------------------------------------------------
    # ウィッチ
    # --------------------------------------------------------

    else if {_target} is a witch:

        set {_egg} to witch spawn egg
        set {_mob-name} to "Witch"


    # --------------------------------------------------------
