    # --------------------------------------------------------

    else if {_target} is a squid:

        set {_egg} to squid spawn egg
        set {_mob-name} to "Squid"


    # --------------------------------------------------------
    # 発光するイカ
    # --------------------------------------------------------

    else if {_target} is a glow squid:

        set {_egg} to glow squid spawn egg
        set {_mob-name} to "Glow Squid"


    # --------------------------------------------------------
    # イルカ
    # --------------------------------------------------------

    else if {_target} is a dolphin:

        set {_egg} to dolphin spawn egg
        set {_mob-name} to "Dolphin"


    # --------------------------------------------------------
    # タラ
    # --------------------------------------------------------

    else if {_target} is a cod:

        set {_egg} to cod spawn egg
        set {_mob-name} to "Cod"


    # --------------------------------------------------------
    # サケ
    # --------------------------------------------------------

    else if {_target} is a salmon:

        set {_egg} to salmon spawn egg
        set {_mob-name} to "Salmon"


    # --------------------------------------------------------
    # 熱帯魚
    # --------------------------------------------------------

    else if {_target} is a tropical fish:

        set {_egg} to tropical fish spawn egg
        set {_mob-name} to "Tropical Fish"


    # --------------------------------------------------------
    # フグ
    # --------------------------------------------------------

    else if {_target} is a pufferfish:

        set {_egg} to pufferfish spawn egg
        set {_mob-name} to "Pufferfish"


    # --------------------------------------------------------
