# ============================================================
# MOB CAPTURE SYSTEM
# Full Test Version
#
# Minecraft Java Edition + Paper + Skript
#
# ============================================================
#
# 機能：
#
#   ニンジン付きの棒でMobを右クリック
#       ↓
#   プレイヤーが見ているMobを判定
#       ↓
#   5ブロック以内なら捕獲
#       ↓
#   MobをKill
#       ↓
#   対応するスポーンエッグを1個取得
#
# ============================================================
#
# COMMANDS
#
#   /capture start
#       捕獲テスト開始
#
#   /capture stop
#       捕獲テスト停止
#
#   /capture reset
#       テスト状態リセット
#
#   /capture
#       ヘルプ表示
#
# ============================================================


# ============================================================
# OPTIONS
# ============================================================

options:

    # --------------------------------------------------------
    # 捕獲に使用するアイテム
    # --------------------------------------------------------

    capture-item: carrot on a stick

    # --------------------------------------------------------
    # 最大捕獲距離
    # --------------------------------------------------------

    capture-distance: 5


# ============================================================
# LOAD
# ============================================================

on load:

    send "[Mob Capture] Full Test Version Loaded." to console


# ============================================================
# CAPTURE CONTROL COMMAND
# ============================================================

command /capture [<text>]:

    permission: op

    trigger:

        # ====================================================
        # START
        # ====================================================

        if arg-1 is "start":

            set {capture.test} to true

            send "&a================================" to player
            send "&a[Mob Capture] TEST START" to player
            send "" to player
            send "&eニンジン付きの棒でMobを右クリックしてください。" to player
            send "&e捕獲距離：{@capture-distance}ブロック" to player
            send "&a================================" to player

            stop


        # ====================================================
        # STOP
        # ====================================================

        if arg-1 is "stop":

            set {capture.test} to false

            send "&c================================" to player
            send "&c[Mob Capture] TEST STOP" to player
            send "&c================================" to player

            stop


        # ====================================================
        # RESET
        # ====================================================

        if arg-1 is "reset":

            delete {capture.test}

            send "&e================================" to player
            send "&e[Mob Capture] TEST RESET" to player
            send "&e================================" to player

            stop


        # ====================================================
        # STATUS
        # ====================================================

        if arg-1 is "status":

            if {capture.test} is true:

                send "&a[Mob Capture] TEST = ON" to player

            else:

                send "&c[Mob Capture] TEST = OFF" to player

            stop


        # ====================================================
        # HELP
        # ====================================================

        send "&e================================" to player
        send "&eMob Capture Test" to player
        send "" to player
        send "&e/capture start &7- テスト開始" to player
        send "&e/capture stop &7- テスト停止" to player
        send "&e/capture reset &7- テストリセット" to player
        send "&e/capture status &7- 状態確認" to player
        send "&e================================" to player


# ============================================================
# RIGHT CLICK
# ============================================================

on right click:

    # --------------------------------------------------------
    # テスト状態確認
    # --------------------------------------------------------

    if {capture.test} is not true:
        stop


    # --------------------------------------------------------
    # 捕獲アイテム確認
    # --------------------------------------------------------

    if player's tool is not {@capture-item}:
        stop


    # ========================================================
    # TARGET ENTITY
    # ========================================================
    #
    # プレイヤーが見ているEntityを取得。
    #
    # 近くにいるMobではなく、
    # 実際にプレイヤーが右クリックした対象を使用する。
    #
    # ========================================================

    set {_target} to clicked entity


    # --------------------------------------------------------
    # Entityが存在しない場合
    # --------------------------------------------------------

    if {_target} is not set:

        send "&cMobを右クリックしてください。" to player

        stop


    # --------------------------------------------------------
    # Living Entity確認
    # --------------------------------------------------------

    if {_target} is not a living entity:

        send "&cそのEntityは捕獲できません。" to player

        stop


    # --------------------------------------------------------
    # Player除外
    # --------------------------------------------------------

    if {_target} is a player:

        stop


    # --------------------------------------------------------
    # 距離確認
    # --------------------------------------------------------

    if distance between player and {_target} > {@capture-distance}:

        send "&cMobが遠すぎます。" to player

        stop


    # ========================================================
    # MOB TYPE
    # ========================================================

    # --------------------------------------------------------
    # 豚
    # --------------------------------------------------------

    if {_target} is a pig:

        set {_egg} to pig spawn egg
        set {_mob-name} to "Pig"


    # --------------------------------------------------------
    # 牛
    # --------------------------------------------------------

    else if {_target} is a cow:

        set {_egg} to cow spawn egg
        set {_mob-name} to "Cow"


    # --------------------------------------------------------
    # 羊
    # --------------------------------------------------------

    else if {_target} is a sheep:

        set {_egg} to sheep spawn egg
        set {_mob-name} to "Sheep"


    # --------------------------------------------------------
    # ニワトリ
    # --------------------------------------------------------

    else if {_target} is a chicken:

        set {_egg} to chicken spawn egg
        set {_mob-name} to "Chicken"


    # --------------------------------------------------------
    # ウサギ
    # --------------------------------------------------------

    else if {_target} is a rabbit:

        set {_egg} to rabbit spawn egg
        set {_mob-name} to "Rabbit"


    # --------------------------------------------------------
    # 馬
    # --------------------------------------------------------

    else if {_target} is a horse:

        set {_egg} to horse spawn egg
        set {_mob-name} to "Horse"


    # --------------------------------------------------------
    # ロバ
    # --------------------------------------------------------

    else if {_target} is a donkey:

        set {_egg} to donkey spawn egg
        set {_mob-name} to "Donkey"


    # --------------------------------------------------------
    # ラバ
    # --------------------------------------------------------

    else if {_target} is a mule:

        set {_egg} to mule spawn egg
        set {_mob-name} to "Mule"


    # --------------------------------------------------------
    # オオカミ
    # --------------------------------------------------------

    else if {_target} is a wolf:

        set {_egg} to wolf spawn egg
        set {_mob-name} to "Wolf"


    # --------------------------------------------------------
    # ネコ
    # --------------------------------------------------------

    else if {_target} is a cat:

        set {_egg} to cat spawn egg
        set {_mob-name} to "Cat"


    # --------------------------------------------------------
    # オウム
    # --------------------------------------------------------

    else if {_target} is a parrot:

        set {_egg} to parrot spawn egg
        set {_mob-name} to "Parrot"


    # --------------------------------------------------------
    # キツネ
    # --------------------------------------------------------

    else if {_target} is a fox:

        set {_egg} to fox spawn egg
        set {_mob-name} to "Fox"


    # --------------------------------------------------------
    # パンダ
    # --------------------------------------------------------

    else if {_target} is a panda:

        set {_egg} to panda spawn egg
        set {_mob-name} to "Panda"


    # --------------------------------------------------------
    # ホッキョクグマ
    # --------------------------------------------------------

    else if {_target} is a polar bear:

        set {_egg} to polar bear spawn egg
        set {_mob-name} to "Polar Bear"


    # --------------------------------------------------------
    # ラマ
    # --------------------------------------------------------

    else if {_target} is a llama:

        set {_egg} to llama spawn egg
        set {_mob-name} to "Llama"


    # --------------------------------------------------------
    # ヤギ
    # --------------------------------------------------------

    else if {_target} is a goat:

        set {_egg} to goat spawn egg
        set {_mob-name} to "Goat"


    # --------------------------------------------------------
