    # --------------------------------------------------------

    else if {_target} is a magma cube:

        set {_egg} to magma cube spawn egg
        set {_mob-name} to "Magma Cube"


    # --------------------------------------------------------
    # ブレイズ
    # --------------------------------------------------------

    else if {_target} is a blaze:

        set {_egg} to blaze spawn egg
        set {_mob-name} to "Blaze"


    # --------------------------------------------------------
