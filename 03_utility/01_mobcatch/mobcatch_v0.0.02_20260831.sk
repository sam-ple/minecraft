    # --------------------------------------------------------

    else if {_target} is a ghast:

        set {_egg} to ghast spawn egg
        set {_mob-name} to "Ghast"


    # --------------------------------------------------------
    # シルバーフィッシュ
    # --------------------------------------------------------

    else if {_target} is a silverfish:

        set {_egg} to silverfish spawn egg
        set {_mob-name} to "Silverfish"


    # --------------------------------------------------------
    # エンダーマイト
    # --------------------------------------------------------

    else if {_target} is an endermite:

        set {_egg} to endermite spawn egg
        set {_mob-name} to "Endermite"


    # --------------------------------------------------------
    # シュルカー
    # --------------------------------------------------------

    else if {_target} is a shulker:

        set {_egg} to shulker spawn egg
        set {_mob-name} to "Shulker"


    # --------------------------------------------------------
    # ピリジャー
    # --------------------------------------------------------

    else if {_target} is a pillager:

        set {_egg} to pillager spawn egg
        set {_mob-name} to "Pillager"


    # --------------------------------------------------------
    # ヴィンディケーター
    # --------------------------------------------------------

    else if {_target} is a vindicator:

        set {_egg} to vindicator spawn egg
        set {_mob-name} to "Vindicator"


    # --------------------------------------------------------
    # エヴォーカー
    # --------------------------------------------------------

    else if {_target} is an evoker:

        set {_egg} to evoker spawn egg
        set {_mob-name} to "Evoker"


    # --------------------------------------------------------
    # ヴェックス
    # --------------------------------------------------------

    else if {_target} is a vex:

        set {_egg} to vex spawn egg
        set {_mob-name} to "Vex"


    # --------------------------------------------------------
    # ウィザースケルトン
    # --------------------------------------------------------

    else if {_target} is a wither skeleton:

        set {_egg} to wither skeleton spawn egg
        set {_mob-name} to "Wither Skeleton"


    # --------------------------------------------------------
    # ホグリン
    # --------------------------------------------------------

    else if {_target} is a hoglin:

        set {_egg} to hoglin spawn egg
        set {_mob-name} to "Hoglin"


    # --------------------------------------------------------
    # ピグリン
    # --------------------------------------------------------

    else if {_target} is a piglin:

        set {_egg} to piglin spawn egg
        set {_mob-name} to "Piglin"


    # --------------------------------------------------------
    # ゾンビピグリン
    # --------------------------------------------------------

    else if {_target} is a zombified piglin:

        set {_egg} to zombified piglin spawn egg
        set {_mob-name} to "Zombified Piglin"


    # --------------------------------------------------------
    # ストライダー
    # --------------------------------------------------------

    else if {_target} is a strider:

        set {_egg} to strider spawn egg
        set {_mob-name} to "Strider"


    # --------------------------------------------------------
    # ウーパールーパー等を含め、
    # 未対応Mobの場合
    # --------------------------------------------------------

    else:

        send "&cこのMobはまだ捕獲対象外です。" to player

        stop


    # ========================================================
    # CAPTURE
    # ========================================================

    # --------------------------------------------------------
    # 成功メッセージ
    # --------------------------------------------------------

    send "&a[Mob Capture] &f%{_mob-name}% &aを捕獲しました！" to player


    # --------------------------------------------------------
    # 捕獲対象を削除
    # --------------------------------------------------------

    kill {_target}


    # --------------------------------------------------------
    # スポーンエッグ取得
    # --------------------------------------------------------

    give 1 of {_egg} to player


    # --------------------------------------------------------
    # 完了メッセージ
    # --------------------------------------------------------

    send "&e→ %{_mob-name}% Spawn Egg ×1" to player
