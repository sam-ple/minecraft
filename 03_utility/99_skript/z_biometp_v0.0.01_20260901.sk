# ============================================================
# BIOME TP TEST
# Version : v0.1.00
#
# Minecraft Java Edition + Paper + Skript 2.16.1
#
# ============================================================
#
# PURPOSE
#
#   指定したバイオームを現在地周辺から探し、
#   安全な地表地点へTPするテスト。
#
# ============================================================
#
# COMMAND
#
#   /biometp <biome>
#
#   例：
#
#   /biometp plains
#   /biometp desert
#   /biometp jungle
#   /biometp forest
#   /biometp taiga
#   /biometp savanna
#   /biometp swamp
#   /biometp badlands
#   /biometp snowy_plains
#
# ============================================================
#
# SEARCH
#
#   現在地を中心にランダム検索
#
#   最大距離       : 5000 blocks
#   最大試行回数   : 300
#
# ============================================================
#
# SAFETY CHECK
#
#   ・指定Biomeである
#   ・最高固体ブロックを取得
#   ・足元が空気
#   ・頭上1ブロックが空気
#   ・頭上2ブロックが空気
#   ・水ではない
#   ・溶岩ではない
#   ・火ではない
#   ・サボテンではない
#   ・粉雪ではない
#   ・危険な地形をできるだけ除外
#
# ============================================================


# ============================================================
# OPTIONS
# ============================================================

options:

    # --------------------------------------------------------
    # 最大探索距離
    # --------------------------------------------------------

    search-radius: 5000

    # --------------------------------------------------------
    # 最大探索回数
    # --------------------------------------------------------

    search-attempts: 300

    # --------------------------------------------------------
    # 1回の検索ごとの待機
    #
    # サーバー負荷軽減用
    # --------------------------------------------------------

    search-delay: 1 tick


# ============================================================
# LOAD
# ============================================================

on load:

    send "[Biome TP Test] v0.1.00 Loaded." to console


# ============================================================
# COMMAND
# ============================================================

command /biometp [<text>]:

    permission: op

    trigger:

        # ====================================================
        # ARGUMENT CHECK
        # ====================================================

        if arg-1 is not set:

            send "&e========================================" to player
            send "&e       BIOME TP TEST v0.1.00" to player
            send "&e========================================" to player
            send "" to player
            send "&f/biometp <biome>" to player
            send "" to player
            send "&7Examples:" to player
            send "&7/biometp plains" to player
            send "&7/biometp desert" to player
            send "&7/biometp jungle" to player
            send "&7/biometp forest" to player
            send "&7/biometp taiga" to player
            send "&7/biometp savanna" to player
            send "&7/biometp swamp" to player
            send "&7/biometp badlands" to player
            send "&7/biometp snowy_plains" to player
            send "" to player
            send "&7現在地から最大 {@search-radius} ブロックを探索します。" to player
            send "&e========================================" to player

            stop


        # ====================================================
        # ALREADY SEARCHING CHECK
        # ====================================================

        if {biometp.busy::%uuid of player%} is true:

            send "&c[Biome TP] 現在すでに検索中です。" to player

            stop


        # ====================================================
        # BIOME PARSE
        # ====================================================

        set {_target-biome} to arg-1 parsed as biome


        # ----------------------------------------------------
        # Invalid biome
        # ----------------------------------------------------

        if {_target-biome} is not set:

            send "&c[Biome TP] 不明なバイオームです。" to player
            send "&7入力: &f%arg-1%" to player
            send "" to player
            send "&7例: plains / desert / jungle / taiga" to player

            stop


        # ====================================================
        # SEARCH START
        # ====================================================

        set {biometp.busy::%uuid of player%} to true

        set {_world} to world of player

        set {_origin-x} to floor(x-coordinate of player)
        set {_origin-z} to floor(z-coordinate of player)


        send "&e========================================" to player
        send "&e[Biome TP] SEARCH START" to player
        send "&7Biome : &f%arg-1%" to player
        send "&7Center : &f%{_origin-x}%, %{_origin-z}%" to player
        send "&7Radius : &f{@search-radius}" to player
        send "&e========================================" to player


        # ====================================================
        # SEARCH
        # ====================================================

        loop {@search-attempts} times:

            # ------------------------------------------------
            # Player still online?
            # ------------------------------------------------

            if player is not online:

                delete {biometp.busy::%uuid of player%}

                stop


            # ------------------------------------------------
            # Random X / Z
            # ------------------------------------------------

            set {_offset-x} to random integer between -{@search-radius} and {@search-radius}
            set {_offset-z} to random integer between -{@search-radius} and {@search-radius}

            set {_candidate-x} to {_origin-x} + {_offset-x}
            set {_candidate-z} to {_origin-z} + {_offset-z}


            # ------------------------------------------------
            # Candidate location
            #
            # Y is irrelevant for the initial biome check.
            # ------------------------------------------------

            set {_candidate} to location at {_candidate-x}, 0, {_candidate-z} of {_world}


            # ------------------------------------------------
            # Biome check
            # ------------------------------------------------

            if biome at {_candidate} is {_target-biome}:


                # =================================================
                # BIOME FOUND
                # =================================================

                send "&a[Biome TP] バイオーム候補を発見しました。" to player
                send "&7X: &f%{_candidate-x}% &7Z: &f%{_candidate-z}%" to player


                # =================================================
                # FIND HIGHEST SOLID BLOCK
                # =================================================

                set {_ground} to highest solid block at {_candidate}


                if {_ground} is set:


                    # ------------------------------------------------
                    # Safe location = one block above ground
                    # ------------------------------------------------

                    set {_safe} to location of {_ground}

                    add 1 to y-coordinate of {_safe}


                    # =================================================
                    # SAFETY CHECK
                    # =================================================

                    set {_safe-ok} to true


                    # ------------------------------------------------
                    # Foot block
                    # ------------------------------------------------

                    if block at {_safe} is not air:

                        set {_safe-ok} to false


                    # ------------------------------------------------
                    # Head block
                    # ------------------------------------------------

                    set {_head1} to {_safe}
                    add 1 to y-coordinate of {_head1}

                    if block at {_head1} is not air:

                        set {_safe-ok} to false


                    # ------------------------------------------------
                    # Extra head clearance
                    # ------------------------------------------------

                    set {_head2} to {_safe}
                    add 2 to y-coordinate of {_head2}

                    if block at {_head2} is not air:

                        set {_safe-ok} to false


                    # =================================================
                    # DANGEROUS GROUND CHECK
                    # =================================================

                    # ------------------------------------------------
                    # Water
                    # ------------------------------------------------

                    if block at {_safe} is water:

                        set {_safe-ok} to false


                    # ------------------------------------------------
                    # Lava
                    # ------------------------------------------------

                    if block at {_safe} is lava:

                        set {_safe-ok} to false


                    # ------------------------------------------------
                    # Fire
                    # ------------------------------------------------

                    if block at {_safe} is fire:

                        set {_safe-ok} to false


                    # ------------------------------------------------
                    # Soul Fire
                    # ------------------------------------------------

                    if block at {_safe} is soul fire:

                        set {_safe-ok} to false


                    # ------------------------------------------------
                    # Powder Snow
                    # ------------------------------------------------

                    if block at {_safe} is powder snow:

                        set {_safe-ok} to false


                    # ------------------------------------------------
                    # Cactus
                    # ------------------------------------------------

                    if block at {_safe} is cactus:

                        set {_safe-ok} to false


                    # ------------------------------------------------
                    # Sweet Berry Bush
                    # ------------------------------------------------

                    if block at {_safe} is sweet berry bush:

                        set {_safe-ok} to false


                    # ------------------------------------------------
                    # Magma Block
                    # ------------------------------------------------

                    if block at {_safe} is magma block:

                        set {_safe-ok} to false


                    # ------------------------------------------------
                    # Campfire
                    # ------------------------------------------------

                    if block at {_safe} is campfire:

                        set {_safe-ok} to false


                    # ------------------------------------------------
                    # Soul Campfire
                    # ------------------------------------------------

                    if block at {_safe} is soul campfire:

                        set {_safe-ok} to false


                    # =================================================
                    # FINAL SAFETY CHECK
                    # =================================================

                    if {_safe-ok} is true:


                        # ------------------------------------------------
                        # Distance from original position
                        # ------------------------------------------------

                        set {_distance} to distance between player and {_safe}


                        # ------------------------------------------------
                        # SUCCESS
                        # ------------------------------------------------

                        send "&a========================================" to player
                        send "&a[Biome TP] SAFE LOCATION FOUND!" to player
                        send "" to player
                        send "&7Biome : &f%arg-1%" to player
                        send "&7X : &f%round(x-coordinate of {_safe})%" to player
                        send "&7Y : &f%round(y-coordinate of {_safe})%" to player
                        send "&7Z : &f%round(z-coordinate of {_safe})%" to player
                        send "&7Distance : &f%round({_distance})% blocks" to player
                        send "&a========================================" to player


                        # ------------------------------------------------
                        # Effect
                        # ------------------------------------------------

                        play sound "entity.enderman.teleport" with volume 1 and pitch 1 to player


                        # ------------------------------------------------
                        # TP
                        # ------------------------------------------------

                        teleport player to {_safe}


                        # ------------------------------------------------
                        # Particle
                        # ------------------------------------------------

                        execute console command "particle minecraft:portal %x-coordinate of {_safe}% %y-coordinate of {_safe}% %z-coordinate of {_safe}% 0.5 1 0.5 0.2 50"


                        # ------------------------------------------------
                        # Finish
                        # ------------------------------------------------

                        delete {biometp.busy::%uuid of player%}

                        stop loop


            # =================================================
            # PROGRESS
            # =================================================

            if loop-iteration is 25:

                send "&7[Biome TP] 検索中... &f25/{@search-attempts}" to player


            if loop-iteration is 50:

                send "&7[Biome TP] 検索中... &f50/{@search-attempts}" to player


            if loop-iteration is 100:

                send "&7[Biome TP] 検索中... &f100/{@search-attempts}" to player


            if loop-iteration is 200:

                send "&7[Biome TP] 検索中... &f200/{@search-attempts}" to player


            # ------------------------------------------------
            # Server load reduction
            # ------------------------------------------------

            wait {@search-delay}


        # ====================================================
        # SEARCH FAILED
        # ====================================================

        if {biometp.busy::%uuid of player%} is true:

            send "&c========================================" to player
            send "&c[Biome TP] SEARCH FAILED" to player
            send "" to player
            send "&7指定したバイオームの安全地点を見つけられませんでした。" to player
            send "&7検索回数 : &f{@search-attempts}" to player
            send "&7検索範囲 : &f{@search-radius} blocks" to player
            send "" to player
            send "&7もう一度実行すると別の場所を探索します。" to player
            send "&c========================================" to player

            delete {biometp.busy::%uuid of player%}